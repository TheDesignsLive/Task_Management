  <div id="deleteModal" class="modal">
    <div class="modal-content">
      <h3>Delete Completed Tasks?</h3>
      <p>This action cannot be undone.</p>
      <div class="modal-buttons">
        <button id="confirmDelete" class="btn delete">Delete</button>
        <button id="cancelDelete" class="btn cancel">Cancel</button>
      </div>
    </div>
  </div>




<script>

  const role = "<%= session.role %>"; // "admin" or "user"

let _refreshPending = false;
let _selfUpdating = false;

function showSkeletons() {
  ['task-section','change-section','update-section','other-section'].forEach(id => {
    const el = document.getElementById(id);
    if (el && el.children.length === 0) {
      el.innerHTML = Array(4).fill('<div class="task-skeleton"></div>').join('');
    }
  });
}

async function refreshTasksUI() {
  if (_refreshPending) return;

  // ✅ If any edit box is open, skip this refresh to avoid destroying user's work
  const anyEditOpen = document.querySelector('.edit-box[style*="flex"]');
  if (anyEditOpen) return;

  _refreshPending = true;
  try {
    const res = await fetch('/api/get-all-tasks');
    const data = await res.json();
    if (data.success) {
      currentTasks = data.tasks;
      renderAllSections(data.tasks);
    }
  } finally {
    _refreshPending = false;
  }
}

let currentTasks = <%- JSON.stringify(tasks) %>;
const allAppMembers = <%- JSON.stringify(members) %>;
const appAdminName = "<%- adminName || 'Admin' %>";

function formatDate(dateStr) {
  if (!dateStr) return '';
  const today = new Date();
  const taskDate = new Date(dateStr);
  today.setHours(0,0,0,0);
  taskDate.setHours(0,0,0,0);

  const tomorrow = new Date(today);
  tomorrow.setDate(today.getDate() + 1);

  if (taskDate.getTime() === today.getTime()) return "Today";
  else if (taskDate.getTime() === tomorrow.getTime()) return "Tom";
  else return taskDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
}

function getPriorityClass(priority) {
  if (!priority) return '';
  const p = priority.toUpperCase();
  if (p === 'HIGH') return 'priority-red';
  if (p === 'MEDIUM') return 'priority-yellow';
  if (p === 'LOW') return 'priority-blue';
  return '';
}

const _checkboxInFlight = new Set();

async function updateTaskStatus(id, status, section=null) {
  _selfUpdating = true;
  setTimeout(() => { _selfUpdating = false; }, 2000);
  const res = await fetch('/update-task-status', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id, status, section })
  });
  _checkboxInFlight.delete(String(id));
  return res.json();
}

function createTaskElement(task) {
  const div = document.createElement('div');
  div.className = 'task-item';
  div.dataset.id = task.id;
  div.dataset.date = task.due_date ? task.due_date.split('T')[0] : '';

div.dataset.assignedBy = task.assigned_by ?? "";
  div.dataset.assignedTo = task.assigned_to ?? "";
  div.dataset.whoAssigned = task.who_assigned ?? "";
  div.dataset.adminId = task.admin_id ?? "";

  if (task.status === 'COMPLETED') div.classList.add('completed-task');

  const priorityClass = getPriorityClass(task.priority);

  let assigneeOptions = '';
  if (role === "admin") {
      assigneeOptions += `<option value="0" ${task.assigned_to == 0 ? 'selected' : ''}>My Self</option>`;
  } else {
      const myId = "<%= session.userId %>";
      assigneeOptions += `<option value="${myId}" ${task.assigned_to == myId ? 'selected' : ''}>My Self</option>`;
      assigneeOptions += `<option value="0" ${task.assigned_to == 0 ? 'selected' : ''}>${appAdminName} (Admin)</option>`;
  }
  allAppMembers.forEach(m => {
      assigneeOptions += `<option value="${m.id}" ${task.assigned_to == m.id ? 'selected' : ''}>${m.name}</option>`;
  });

  div.innerHTML = `
    <div class="task-row">
      <input type="checkbox" class="task-checkbox ${priorityClass}" ${task.status === 'COMPLETED' ? 'checked' : ''} />
      <div class="task-title">${task.title}</div>
      <div class="task-name">${task.assigned_by_name || ''}</div>
      
  ${task.description ? `
<svg class="info-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
  <circle cx="12" cy="12" r="10"></circle>
  <line x1="12" y1="8" x2="12" y2="8.5"></line>
  <line x1="12" y1="11" x2="12" y2="16"></line>
</svg>
` : ''}

      ${task.repeat_type && task.repeat_type !== 'none' ? `
        <span class="repeat-badge" style="
          font-size:9px; color:#a78bfa; cursor:pointer;
          padding:2px 5px; border-radius:3px;
          background:rgba(167,139,250,0.1);
          border:1px solid rgba(167,139,250,0.35);
          font-weight:700; letter-spacing:0.3px;
          white-space:nowrap; flex-shrink:0;
          line-height:1.4;
        ">🔁 ${task.repeat_type}</span>
      ` : ''}

      
        <div class="task-date ${isPastDate(task.due_date) && task.status !== 'COMPLETED' ? 'past-date' : ''}">
          ${formatDate(task.due_date)}
        </div>




        <div class="dots-btn">
        <i class="fa-solid fa-ellipsis-vertical"></i>
      </div>

<div class="${task.status === 'COMPLETED' ? 'completed-menu' : 'task-options-menu'}">
        ${task.status !== 'COMPLETED' ? `<div class="edit-opt"><i class="fa-solid fa-pen"></i> Edit</div>` : ''}
        ${task.status !== 'COMPLETED' ? `<div class="repeat-opt"><i class="fa-solid fa-rotate"></i> Repeat</div>` : ''}
        ${task.status === 'COMPLETED' ? `<div class="edit-opt"><i class="fa-solid fa-pen"></i> Edit</div>` : ''}
        <div class="delete-opt" style="color:red"><i class="fa-solid fa-trash"></i> Delete</div>
      </div>
    </div>

    <div class="edit-box">
      <input type="text" class="edit-title" value="${task.title}" placeholder="Title">
      <textarea class="edit-desc" placeholder="Description">${task.description || ''}</textarea>
      <div style="display:flex; gap:5px;">
        <select class="edit-priority" style="flex:1;">
          <option value="HIGH" ${task.priority === 'HIGH' ? 'selected' : ''}>High</option>
          <option value="MEDIUM" ${task.priority === 'MEDIUM' ? 'selected' : ''}>Medium</option>
          <option value="LOW" ${task.priority === 'LOW' ? 'selected' : ''}>Low</option>
        </select>
        <input type="text" class="edit-date" placeholder="Due Date" style="flex:1;">
      </div>
      <select class="edit-assignee" style="width:100%; margin-top:5px;">
          ${assigneeOptions}
      </select>
      <div class="edit-actions" style="margin-top:5px;">
        <button class="save-btn">Save</button>
        <button class="cancel-btn">Cancel</button>
      </div>
    </div>

    <div class="task-details">
      <div class="task-desc-text">${task.description || 'No description provided.'}</div>
    </div>
  `;

  if (task.status !== 'COMPLETED') div.draggable = true;

  const autoResizeTextarea = (textarea) => {
    textarea.style.height = 'auto';
    textarea.style.height = textarea.scrollHeight + 'px';
  };

div.addEventListener('dblclick', (e) => {
    if (e.target.closest('.task-checkbox, .dots-btn, .task-options-menu, .completed-menu, .repeat-badge')) return;
    const editBox = div.querySelector('.edit-box');
    if (editBox.style.display === 'flex') {
      editBox.style.display = 'none';
      if (task.status !== 'COMPLETED') div.draggable = true;
      return;
    }
    div.draggable = false;
    editBox.style.display = 'flex';
    const descTextarea = editBox.querySelector('.edit-desc');
    const dateInput = editBox.querySelector('.edit-date');
    autoResizeTextarea(descTextarea);
    descTextarea.addEventListener('input', () => autoResizeTextarea(descTextarea));
    if (dateInput._flatpickr) dateInput._flatpickr.destroy();
    let dbDate = task.due_date;
    if (dbDate) dateInput.value = dbDate.split('T')[0];
    flatpickr(dateInput, { dateFormat: "Y-m-d", defaultDate: dateInput.value || null });
  });

  const dotsBtn = div.querySelector('.dots-btn');
const menu = div.querySelector('.task-options-menu, .completed-menu');
  dotsBtn.addEventListener('click', (e) => {
    e.stopPropagation();
document.querySelectorAll('.task-options-menu, .completed-menu')
.forEach(m => m.style.display = 'none');
  menu.style.display = 'block';
menu.style.zIndex = 2000;
  });

const editOpt = div.querySelector('.edit-opt');
  if (editOpt) {
    editOpt.addEventListener('click', () => {
      menu.style.display = 'none';
      const editBox = div.querySelector('.edit-box');
      if (editBox.style.display === 'flex') {
        editBox.style.display = 'none';
        if (task.status !== 'COMPLETED') div.draggable = true;
        return;
      }
      div.draggable = false;
      editBox.style.display = 'flex';
      const descTextarea = editBox.querySelector('.edit-desc');
      const dateInput = editBox.querySelector('.edit-date');
      const autoResizeTextarea = (textarea) => {
        textarea.style.height = 'auto';
        textarea.style.height = textarea.scrollHeight + 'px';
      };
      autoResizeTextarea(descTextarea);
      descTextarea.addEventListener('input', () => autoResizeTextarea(descTextarea));
      if (dateInput._flatpickr) dateInput._flatpickr.destroy();
      let dbDate = task.due_date;
      if (dbDate) dateInput.value = dbDate.split('T')[0];
      flatpickr(dateInput, { dateFormat: "Y-m-d", defaultDate: dateInput.value || null });
    });
  }

  // ── Repeat option ──
  const repeatOptEl = div.querySelector('.repeat-opt');
  if (repeatOptEl) {
    repeatOptEl.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.style.display = 'none';

      // Build repeat modal
      const existing = document.getElementById('repeat-modal-overlay');
      if (existing) existing.remove();

      const overlay = document.createElement('div');
      overlay.id = 'repeat-modal-overlay';
      overlay.style.cssText = `
        position:fixed; inset:0; background:rgba(0,0,0,0.6);
        z-index:99999; display:flex; align-items:center; justify-content:center;
      `;

      const currentRepeat = task.repeat_type || 'none';
      const options = [
        { value: 'none',    label: 'Off',          icon: '🚫', desc: 'Does not repeat' },
        { value: 'daily',   label: 'Every day',    icon: '📆', desc: 'Repeats daily' },
        { value: 'weekly',  label: 'Every week',   icon: '🗓️', desc: 'Same day each week' },
        { value: 'monthly', label: 'Every month',  icon: '📅', desc: 'Same date each month' },
      ];

      overlay.innerHTML = `
        <div style="
          background:#2E2D2D; border-radius:16px; border-top:2px solid #0F8989;
          width:320px; overflow:hidden; box-shadow:0 8px 32px rgba(0,0,0,0.6);
          font-family:Arial,sans-serif;
        ">
          <div style="padding:14px 18px 10px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #3C3A3A;">
            <span style="color:#CDF4F4; font-weight:700; font-size:15px;">🔁 Repeat Task</span>
            <button id="repeat-modal-close" style="
              background:#3C3A3A; border:1px solid #0F8989; color:#aaa;
              width:28px; height:28px; border-radius:8px; cursor:pointer; font-size:12px;
            ">✕</button>
          </div>
          <div>
            ${options.map(opt => `
              <button data-repeat-val="${opt.value}" style="
                display:flex; align-items:center; gap:12px;
                width:100%; border:none; border-bottom:1px solid #3C3A3A;
                padding:14px 18px; cursor:pointer; text-align:left;
                font-family:Arial,sans-serif;
                background:${currentRepeat === opt.value ? 'rgba(15,137,137,0.12)' : '#2E2D2D'};
              ">
                <span style="font-size:20px;">${opt.icon}</span>
                <span style="flex:1;">
                  <span style="display:block; color:#eee; font-size:14px; font-weight:${currentRepeat === opt.value ? 700 : 400};">${opt.label}</span>
                  <span style="display:block; color:#aaa; font-size:11px; margin-top:2px;">${opt.desc}</span>
                </span>
                ${currentRepeat === opt.value ? '<span style="color:#0F8989; font-size:18px;">✓</span>' : ''}
              </button>
            `).join('')}
          </div>
        </div>
      `;

      document.body.appendChild(overlay);

      document.getElementById('repeat-modal-close').addEventListener('click', () => overlay.remove());
      overlay.addEventListener('click', (ev) => { if (ev.target === overlay) overlay.remove(); });

 overlay.querySelectorAll('[data-repeat-val]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const newRepeat = btn.dataset.repeatVal;
          overlay.remove();
          await fetch('/api/repeat/set-repeat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ task_id: task.id, repeat_type: newRepeat })
          });
          await refreshTasksUI();
        });
      });
    });
  }

  // ── Repeat badge click → opens same repeat modal ──
  const repeatBadge = div.querySelector('.repeat-badge');
  if (repeatBadge) {
    repeatBadge.addEventListener('click', (e) => {
      e.stopPropagation();
      if (repeatOptEl) repeatOptEl.dispatchEvent(new Event('click', { bubbles: false }));
    });
  }

  div.querySelector('.cancel-btn').addEventListener('click', (e) => {
    e.stopPropagation();
    div.querySelector('.edit-box').style.display = 'none';
    if (task.status !== 'COMPLETED') div.draggable = true; // ✅ RE-ENABLE DRAG
  });

div.querySelector('.save-btn').addEventListener('click', async (e) => {
    e.stopPropagation();
    const title = div.querySelector('.edit-title').value;
    const description = div.querySelector('.edit-desc').value;
    const priority = div.querySelector('.edit-priority').value;
    const assigned_to = div.querySelector('.edit-assignee').value;
    let due_date = div.querySelector('.edit-date').value.trim();
    if (due_date === "") due_date = null;

    // ✅ Close edit box immediately — don't wait for server
    div.querySelector('.edit-box').style.display = 'none';
    if (task.status !== 'COMPLETED') div.draggable = true;

    // ✅ Update local state instantly so UI reflects change without waiting
    const localTask = currentTasks.find(t => t.id == task.id);
    if (localTask) {
      localTask.title = title;
      localTask.description = description;
      localTask.priority = priority;
      localTask.due_date = due_date;
    }
    renderAllSections(currentTasks);

    // ✅ Fire-and-forget — socket will sync other users
    _selfUpdating = true;
    fetch('/edit-task-details', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: task.id, title, description, priority, due_date, assigned_to })
    }).then(() => {
      setTimeout(() => { _selfUpdating = false; }, 2000);
    }).catch(() => {
      _selfUpdating = false;
    });
  });

const infoIcon = div.querySelector('.info-icon');

if(infoIcon){
  infoIcon.addEventListener('click', (e) => {
    e.stopPropagation();
    div.classList.toggle('expanded');
  });
}

div.querySelector('.task-checkbox').addEventListener('change', async (e) => {
    const taskIdStr = String(task.id);
    if (_checkboxInFlight.has(taskIdStr)) {
      e.target.checked = !e.target.checked;
      return;
    }
    _checkboxInFlight.add(taskIdStr);

    const isChecked = e.target.checked;
    const status = isChecked ? 'COMPLETED' : 'OPEN';
    const section = isChecked ? 'COMPLETED' : 'TASK';

    // ✅ INSTANT visual feedback — move card immediately, no wait
    const localTask = currentTasks.find(t => t.id == task.id);
    if (localTask) {
      localTask.status = status;
      localTask.section = section;
      localTask.completed_at = status === 'COMPLETED' ? new Date().toISOString() : null;
    }
    renderAllSections(currentTasks);

    // ✅ Fire-and-forget — do NOT await, do NOT refreshTasksUI after
    // Socket will trigger refresh for OTHER users; this user already sees the update
    _selfUpdating = true;
    fetch('/update-task-status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: task.id, status, section })
    }).then(() => {
      _checkboxInFlight.delete(taskIdStr);
      setTimeout(() => { _selfUpdating = false; }, 2000);
    }).catch(() => {
      // On error: revert local state and re-render
      _checkboxInFlight.delete(taskIdStr);
      _selfUpdating = false;
      if (localTask) {
        localTask.status = isChecked ? 'OPEN' : 'COMPLETED';
        localTask.section = isChecked ? 'TASK' : 'COMPLETED';
        localTask.completed_at = null;
      }
      renderAllSections(currentTasks);
    });
  });

  // ── Multi-select attach ──
  if (task.status !== 'COMPLETED') {
    attachMultiSelectToTask(div, task.id);
  }

  return div;
}

document.addEventListener('click', () => {
  document.querySelectorAll('.task-options-menu, .completed-menu')
  .forEach(m => m.style.display = 'none');
});

function isPastDate(dateStr) {
  if (!dateStr) return false;
  const today = new Date();
  const taskDate = new Date(dateStr);
  today.setHours(0,0,0,0);
  taskDate.setHours(0,0,0,0);
  return taskDate < today;
}

function renderAllSections(taskList) {
  const sections = {
    'TASK': document.getElementById('task-section'),
    'CHANGES': document.getElementById('change-section'),
    'UPDATE': document.getElementById('update-section'),
    'OTHERS': document.getElementById('other-section'),
    'COMPLETED': document.getElementById('completed-section')
  };

  Object.values(sections).forEach(s => s.innerHTML = '');

  const sectionTasks = { 'TASK': [], 'CHANGES': [], 'UPDATE': [], 'OTHERS': [], 'COMPLETED': [] };

  taskList.forEach(task => {
    const targetSection = task.status === 'COMPLETED' ? 'COMPLETED' : (task.section || 'TASK');
    if (sectionTasks[targetSection]) sectionTasks[targetSection].push(task);
  });

  ['TASK','CHANGES','UPDATE','OTHERS'].forEach(sec => {
    const list = sectionTasks[sec];
    if (!list.length) return;
    const taskGroups = {};
    const noDateTasks = [];
    list.forEach(t => {
      const d = t.due_date ? t.due_date.split('T')[0] : null;
      if (!d) noDateTasks.push(t);
      else { if (!taskGroups[d]) taskGroups[d] = []; taskGroups[d].push(t); }
    });
    Object.keys(taskGroups).sort().forEach(d => {
      appendTasksToContainer(sections[sec], sortByPriority(taskGroups[d]), d);
    });
    appendTasksToContainer(sections[sec], sortByPriority(noDateTasks), null);
  });
sectionTasks['COMPLETED']
    .sort((a, b) => {
      // ✅ ASC: oldest completed_at first, newest last
      const ta = a.completed_at ? new Date(a.completed_at).getTime() : 0;
      const tb = b.completed_at ? new Date(b.completed_at).getTime() : 0;
      return ta - tb;
    })
    .forEach(task => sections['COMPLETED'].appendChild(createTaskElement(task)));
attachDateEvents();

  // Update column header counts
  const labelC = document.getElementById('header-changes');
  const labelU = document.getElementById('header-update');
  const taskHeader = document.querySelector('.column-header');
  const countMap = {
    'task-section':   sectionTasks['TASK'].length,
    'change-section': sectionTasks['CHANGES'].length,
    'update-section': sectionTasks['UPDATE'].length,
    'other-section':  sectionTasks['OTHERS'].length,
  };
document.querySelectorAll('.column-header[id]').forEach(h => {
    const sec = h.id === 'header-changes' ? 'change-section' : 'update-section';
    const base = h.textContent.replace(/\s*\(\d+\)$/, '').trim();
    h.textContent = base;
  });
const taskCol = document.querySelector('.task-column .column-header');
  if (taskCol) {
    const base = taskCol.textContent.replace(/\s*\(\d+\)$/, '').trim();
    taskCol.textContent = base;
  }
  const otherCol = document.querySelector('.column-wrapper:last-of-type .column-header');
  if (otherCol && !otherCol.id) {
    const base = otherCol.textContent.replace(/\s*\(\d+\)$/, '').trim();
    otherCol.textContent = base;
  }
}

function appendTasksToContainer(container, taskArray, dateStr) {
  taskArray.forEach(task => container.appendChild(createTaskElement(task)));
  if(taskArray.length > 0) container.appendChild(createSeparator(dateStr));
}

//inside Task(task-main) drag and drop
function enableDateDragForAllSections() {

  const sections = [
    'task-section',
    'change-section',
    'update-section',
    'other-section'
  ];

  sections.forEach(id => {

    const container = document.getElementById(id);

    container.addEventListener('dragover', (e) => {
      e.preventDefault();
    });

    container.addEventListener('drop', async (e) => {
      e.preventDefault();

      const draggingId = e.dataTransfer.getData('text/plain');
      if (!draggingId) return;

      const targetEl = e.target.closest('.task-item, .date-separator');
      if (!targetEl) return;

      let rawDate = targetEl.dataset.date ? targetEl.dataset.date.trim() : null;
      if (!rawDate) return;

      const parts = rawDate.split("-");
      if (parts.length !== 3) return;

      const due_date = `${parts[0]}-${parts[1]}-${parts[2]}`;

      if (draggingId === '__multi__') {
        const ids = [...selectedTaskIds];
        if (!ids.length) return;
        await fetch('/api/bulk-update-date', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids, due_date })
        });
      } else {
        await fetch('/update-task-date', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: draggingId, due_date })
        });
      }

      await refreshTasksUI();
    });

  });
}

