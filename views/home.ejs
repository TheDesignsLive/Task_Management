// =============================================
// MULTI SELECT SYSTEM
// =============================================

let selectedTaskIds = new Set();
let lastClickedTaskEl = null;

function getAllVisibleTaskEls() {
  return Array.from(document.querySelectorAll('.task-item:not(.completed-task)'));
}

function updateSelectionUI() {
  const bar = document.getElementById('multi-select-bar');
  const count = document.getElementById('multi-select-count');
  getAllVisibleTaskEls().forEach(el => {
    if (selectedTaskIds.has(el.dataset.id)) {
      el.classList.add('selected');
    } else {
      el.classList.remove('selected');
    }
  });
  if (bar && count) {
    if (selectedTaskIds.size > 0) {
      bar.classList.add('visible');
      count.textContent = selectedTaskIds.size + ' selected';
    } else {
      bar.classList.remove('visible');
    }
  }
}

function clearSelection() {
  selectedTaskIds.clear();
  lastClickedTaskEl = null;
  updateSelectionUI();
  document.body.classList.remove('no-select');
}

function selectTask(el, taskId) {
  selectedTaskIds.add(String(taskId));
  lastClickedTaskEl = el;
  updateSelectionUI();
}

function toggleTask(el, taskId) {
  const id = String(taskId);
  if (selectedTaskIds.has(id)) {
    selectedTaskIds.delete(id);
  } else {
    selectedTaskIds.add(id);
    lastClickedTaskEl = el;
  }
  updateSelectionUI();
}

function shiftSelectTo(el) {
  // Always use same-section elements for range select
  const sectionEls = getTaskElsInSameSection(el);
  if (!lastClickedTaskEl || !sectionEls.includes(lastClickedTaskEl)) {
    selectTask(el, el.dataset.id);
    return;
  }
  const fromIdx = sectionEls.indexOf(lastClickedTaskEl);
  const toIdx = sectionEls.indexOf(el);
  const start = Math.min(fromIdx, toIdx);
  const end = Math.max(fromIdx, toIdx);
  for (let i = start; i <= end; i++) {
    selectedTaskIds.add(String(sectionEls[i].dataset.id));
  }
  updateSelectionUI();
}

// ── Helper: get the section container id for a task element ──
function getSectionIdForEl(el) {
  const section = el.closest('[id$="-section"]');
  return section ? section.id : null;
}

// ── Helper: get all visible task els inside the SAME section as the anchor ──
function getTaskElsInSameSection(anchorEl) {
  const sectionId = getSectionIdForEl(anchorEl);
  if (!sectionId) return [];
  const container = document.getElementById(sectionId);
  if (!container) return [];
  return Array.from(container.querySelectorAll('.task-item:not(.completed-task)'));
}

function attachMultiSelectToTask(div, taskId) {
  // Long-press for mobile
  let pressTimer = null;
  div.addEventListener('touchstart', (e) => {
    pressTimer = setTimeout(() => {
      document.body.classList.add('no-select');
      if (lastClickedTaskEl && getSectionIdForEl(lastClickedTaskEl) !== getSectionIdForEl(div)) {
        clearSelection();
      }
      toggleTask(div, taskId);
    }, 600);
  }, { passive: true });
  div.addEventListener('touchend', () => clearTimeout(pressTimer));
  div.addEventListener('touchmove', () => clearTimeout(pressTimer));

  // Left-click: select / shift-range / ctrl-toggle
  div.addEventListener('click', (e) => {
    if (e.target.closest('.task-checkbox, .dots-btn, .task-options-menu, .completed-menu, .edit-box, .info-icon, .repeat-badge')) return;

    if (e.shiftKey && lastClickedTaskEl) {
      e.preventDefault();
      e.stopPropagation();
      document.body.classList.add('no-select');
      if (getSectionIdForEl(lastClickedTaskEl) !== getSectionIdForEl(div)) {
        clearSelection();
        selectTask(div, taskId);
      } else {
        shiftSelectTo(div);
      }
      return;
    }

    if (e.ctrlKey || e.metaKey) {
      e.preventDefault();
      e.stopPropagation();
      document.body.classList.add('no-select');
      if (lastClickedTaskEl && getSectionIdForEl(lastClickedTaskEl) !== getSectionIdForEl(div)) {
        clearSelection();
        selectTask(div, taskId);
      } else {
        toggleTask(div, taskId);
      }
      return;
    }

    // Plain left-click
    if (selectedTaskIds.size > 0) {
      e.stopPropagation();
      if (selectedTaskIds.has(String(taskId))) {
        selectedTaskIds.delete(String(taskId));
        updateSelectionUI();
      } else {
        if (lastClickedTaskEl && getSectionIdForEl(lastClickedTaskEl) !== getSectionIdForEl(div)) {
          clearSelection();
          selectTask(div, taskId);
        } else {
          clearSelection();
        }
      }
      return;
    }

    e.stopPropagation();
    selectTask(div, taskId);
    return;
  });

  // Right-click drag to select/deselect (REMOVED — right-click now only opens menu)

// Right-click → handled by global contextmenu listener
  div.addEventListener('contextmenu', (e) => {
    e.preventDefault();
    // ✅ DO NOT stopPropagation — let global handler catch it
  });
}

// ── Context Menu ──
let ctxMenu = null;
let _ctxMenuOpen = false;

document.addEventListener('DOMContentLoaded', () => {
  ctxMenu = document.getElementById('task-context-menu');

  // ── Load dynamic section labels (Change / Update) ──
  fetch('/api/section-labels')
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        // context menu labels
        const elC = document.getElementById('ctx-label-changes');
        const elU = document.getElementById('ctx-label-update');
        if (elC) elC.textContent = data.labelChanges;
        if (elU) elU.textContent = data.labelUpdate;
        // column headers
        const hC = document.getElementById('header-changes');
        const hU = document.getElementById('header-update');
  if (hC) hC.textContent = data.labelChanges.charAt(0).toUpperCase() + data.labelChanges.slice(1).toLowerCase();
        if (hU) hU.textContent = data.labelUpdate.charAt(0).toUpperCase() + data.labelUpdate.slice(1).toLowerCase();
      }
    })
    .catch(() => {}); // silently fail, defaults already set in HTML
});

function showContextMenu(x, y) {
  if (!ctxMenu) ctxMenu = document.getElementById('task-context-menu');
  if (!ctxMenu) return;

  const count = selectedTaskIds.size;
  const label = document.getElementById('ctx-selected-label');
  if (label) label.textContent = count + ' task' + (count !== 1 ? 's' : '') + ' selected';

  const selectedEls = getAllVisibleTaskEls().filter(el => selectedTaskIds.has(el.dataset.id));

  // ── Gather section for each selected task ──
  const sectionsSet = new Set(selectedEls.map(el => {
    const parentId = el.closest('[id$="-section"]')?.id;
    if (parentId === 'task-section')    return 'TASK';
    if (parentId === 'other-section')   return 'OTHERS';
    if (parentId === 'change-section')  return 'CHANGES';
    if (parentId === 'update-section')  return 'UPDATE';
    return null;
  }));

  const sectionSection = document.getElementById('ctx-section-section');

  // ── All 4 move buttons ──
  const btnTask    = sectionSection.querySelector('.ctx-item[data-action="section-TASK"]');
  const btnOthers  = sectionSection.querySelector('.ctx-item[data-action="section-OTHERS"]');
  const btnChanges = sectionSection.querySelector('.ctx-item[data-action="section-CHANGES"]');
  const btnUpdate  = sectionSection.querySelector('.ctx-item[data-action="section-UPDATE"]');

  // Hide all first
  [btnTask, btnOthers, btnChanges, btnUpdate].forEach(b => { if (b) b.style.display = 'none'; });

  // ── Only one section type selected ──
  const sections = [...sectionsSet].filter(Boolean);
  const allSame  = sections.length === 1;
  const theSection = allSame ? sections[0] : null;

// ── Check assigned conditions across ALL selected tasks ──
  // For admin: own task = assigned_to is "0" AND who_assigned is "admin"
  // For user: own task = assigned_by === assigned_to
  const allOwnTasks = selectedEls.every(el => {
    const assignedTo  = String(el.dataset.assignedTo);
    const whoAssigned = String(el.dataset.whoAssigned);
    if (whoAssigned === 'admin') {
      // Admin's own task: assigned_to=0, who_assigned=admin
      return assignedTo === '0';
    }
    // User's own task: assigned_by === assigned_to
    return String(el.dataset.assignedBy) === String(el.dataset.assignedTo);
  });

  const allOthersTasks = selectedEls.every(el => {
    const assignedTo  = String(el.dataset.assignedTo);
    const whoAssigned = String(el.dataset.whoAssigned);
    if (whoAssigned === 'admin') {
      // Admin's "others" task: assigned_to != 0 (assigned to a user)
      return assignedTo !== '0';
    }
    // User's "others" task: assigned_by !== assigned_to
    return String(el.dataset.assignedBy) !== String(el.dataset.assignedTo);
  });

  // ── Check all same admin_id ──
  const adminIds = new Set(selectedEls.map(el => el.dataset.adminId));
  const sameAdmin = adminIds.size === 1;

  let showSection = false;

  if (allSame && sameAdmin) {

    if (theSection === 'TASK') {
      // FROM TASK → can go to CHANGE or UPDATE only
      if (btnChanges) btnChanges.style.display = 'flex';
      if (btnUpdate)  btnUpdate.style.display  = 'flex';
      showSection = true;
    }

    else if (theSection === 'OTHERS') {
      // FROM OTHERS → can go to CHANGE or UPDATE only
      if (btnChanges) btnChanges.style.display = 'flex';
      if (btnUpdate)  btnUpdate.style.display  = 'flex';
      showSection = true;
    }

else if (theSection === 'CHANGES') {
      // FROM CHANGE:
      // all own tasks (assignedBy==assignedTo) → TASK + UPDATE
      // all others tasks (assignedBy!=assignedTo) → OTHERS + UPDATE
      // mixed → UPDATE only
      if (allOwnTasks) {
        if (btnTask)   btnTask.style.display   = 'flex';
        if (btnUpdate) btnUpdate.style.display = 'flex';
        showSection = true;
      } else if (allOthersTasks) {
        if (btnOthers) btnOthers.style.display = 'flex';
        if (btnUpdate) btnUpdate.style.display = 'flex';
        showSection = true;
      } else {
        // mixed assigned → show UPDATE only
        if (btnUpdate) btnUpdate.style.display = 'flex';
        showSection = true;
      }
    }

    else if (theSection === 'UPDATE') {
      // FROM UPDATE:
      // all own tasks → TASK + CHANGE
      // all others tasks → OTHERS + CHANGE
      // mixed → CHANGE only
      if (allOwnTasks) {
        if (btnTask)    btnTask.style.display    = 'flex';
        if (btnChanges) btnChanges.style.display = 'flex';
        showSection = true;
      } else if (allOthersTasks) {
        if (btnOthers)  btnOthers.style.display  = 'flex';
        if (btnChanges) btnChanges.style.display = 'flex';
        showSection = true;
      } else {
        // mixed assigned → show CHANGE only
        if (btnChanges) btnChanges.style.display = 'flex';
        showSection = true;
      }
    }
  }

  sectionSection.style.display = showSection ? 'block' : 'none';

ctxMenu.style.display = 'block';
  _ctxMenuOpen = true;

  // Measure actual rendered size after showing
  const menuW = ctxMenu.offsetWidth || 220;
  const menuH = ctxMenu.offsetHeight || 400;
  let left = x + 4;
  let top  = y + 4;
  if (left + menuW > window.innerWidth)  left = x - menuW - 4;
  if (top  + menuH > window.innerHeight) top  = y - menuH - 4;
  if (top < 4) top = 4;
  if (left < 4) left = 4;
  ctxMenu.style.left = left + 'px';
  ctxMenu.style.top  = top  + 'px';
}

function hideContextMenu() {
  if (!ctxMenu) ctxMenu = document.getElementById('task-context-menu');
  if (ctxMenu) ctxMenu.style.display = 'none';
  _ctxMenuOpen = false;
}

// Close menu only on genuine left-click outside
document.addEventListener('mousedown', (e) => {
  if (e.button !== 0) return; // only left mouse button
  if (!_ctxMenuOpen) return;
  if (ctxMenu.contains(e.target)) return;
  hideContextMenu();
});

// Escape clears selection
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') { hideContextMenu(); clearSelection(); }
});

// Click on empty board area clears selection
document.querySelector('.board-scroll').addEventListener('click', (e) => {
  if (e.target.closest('#multi-select-bar')) return;
  if (!e.target.closest('.task-item') && !e.target.closest('#task-context-menu')) {
    clearSelection();
  }
});

// Block default context menu on board; show custom menu if tasks selected
document.addEventListener('contextmenu', (e) => {

  // ✅ allow normal clicks inside menu
  if (e.target.closest('#task-context-menu')) {
    return;
  }

  e.preventDefault();

  if (selectedTaskIds.size === 0) return;

  showContextMenu(e.clientX, e.clientY);
});

// Shift+Arrow key extends selection
document.addEventListener('keydown', (e) => {
  if (selectedTaskIds.size === 0) return;
  if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
  if (!e.shiftKey) return;
  e.preventDefault();
  const allEls = getAllVisibleTaskEls();
  if (!lastClickedTaskEl) return;
  const idx = allEls.indexOf(lastClickedTaskEl);
  const nextIdx = e.key === 'ArrowDown' ? idx + 1 : idx - 1;
  if (nextIdx < 0 || nextIdx >= allEls.length) return;
  const nextEl = allEls[nextIdx];
  selectedTaskIds.add(String(nextEl.dataset.id));
  lastClickedTaskEl = nextEl;
  nextEl.scrollIntoView({ block: 'nearest' });
  updateSelectionUI();
});

// ── Context menu action handlers ──
function getTargetDate(action) {
  // Use local date math — avoids UTC timezone shift bugs
  const now = new Date();
  const y = now.getFullYear();
  const m = now.getMonth();
  const d = now.getDate();

  let target;
  if (action === 'date-today') {
    target = new Date(y, m, d);
  } else if (action === 'date-tomorrow') {
    target = new Date(y, m, d + 1);
  } else if (action === 'date-7') {
    target = new Date(y, m, d + 7);
  } else if (action === 'date-30') {
    target = new Date(y, m + 1, d);
  } else {
    return null;
  }

  // Format as YYYY-MM-DD without UTC shift
  const yy = target.getFullYear();
  const mm = String(target.getMonth() + 1).padStart(2, '0');
  const dd = String(target.getDate()).padStart(2, '0');
  return `${yy}-${mm}-${dd}`;
}

// ── Unified action handler for date + priority icon btns ──
function handleCtxAction(action) {
  const ids = [...selectedTaskIds];
  if (!ids.length) return;

  // DATE ACTIONS
  if (action === 'date-custom') {
    hideContextMenu();

    // Remove any stale flatpickr instance
    const input = document.getElementById('ctx-custom-date-input');
    if (input._flatpickr) {
      input._flatpickr.destroy();
    }

    let fpCustom = null;
    let picked = false; // guard: only fire once

    fpCustom = flatpickr(input, {
      dateFormat: 'Y-m-d',
      appendTo: document.body,
      disableMobile: true,
      onOpen: function(selectedDates, dateStr, instance) {
        instance.calendarContainer.classList.add('center-calendar');
      },
      onChange: async function(selectedDates, dateStr) {
        if (!dateStr || picked) return;
        picked = true;

        // Close & destroy BEFORE the async fetch so no second fire
        try { fpCustom.close(); } catch(e) {}
        try { fpCustom.destroy(); } catch(e) {}

        const res = await fetch('/api/bulk-update-date', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids, due_date: dateStr })
        });
        const data = await res.json();

function showToast(msg) {
  const t = document.createElement('div');
  t.textContent = msg;
  t.style.cssText = 'position:fixed;bottom:70px;left:50%;transform:translateX(-50%);background:#0F8989;color:white;padding:8px 20px;border-radius:100px;font-size:12px;font-weight:700;z-index:99999;pointer-events:none;opacity:1;transition:opacity 0.4s;';
  document.body.appendChild(t);
  setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 400); }, 2000);
}
      },
      onClose: function() {
        // If user dismissed without picking, clean up
        setTimeout(() => {
          try { if (fpCustom) fpCustom.destroy(); } catch(e) {}
        }, 200);
      }
    });

    fpCustom.open();
    return;
  }

  if (action.startsWith('date-')) {
    hideContextMenu();
    const due_date = getTargetDate(action);
    if (!due_date) return;

    fetch('/api/bulk-update-date', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids, due_date })
    })
    .then(r => r.json())
    .then(async data => {
      if (data.success) {
        clearSelection();
        await refreshTasksUI();
        showToast('Dates updated');
      }
    })
    .catch(err => console.error('bulk-update-date error:', err));
    return;
  }

  // PRIORITY ACTIONS
  if (action.startsWith('priority-')) {
    hideContextMenu();
    const priority = action.replace('priority-', '');
    fetch('/api/bulk-update-priority', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids, priority })
    })
    .then(r => r.json())
    .then(async data => {
      if (data.success) {
        clearSelection();
        await refreshTasksUI();
        showToast('Priority updated');
      }
    })
    .catch(err => console.error('bulk-update-priority error:', err));
    return;
  }
}

// Date icon buttons
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.ctx-icon-btn').forEach(btn => {

