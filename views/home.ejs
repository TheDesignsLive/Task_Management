const containers = { 
  'task-section': 'TASK', 
  'change-section': 'CHANGES', 
  'update-section': 'UPDATE',
  'other-section': 'OTHERS'
};

function isDropAllowed(draggingId, containerId) {
  const draggedEl = document.querySelector(`.task-item[data-id='${draggingId}']`);
  if (!draggedEl) return null;
  const parent = draggedEl.parentElement;
  const currentSection = parent.id;
  const targetSection = containers[containerId];
  const assignedBy = draggedEl.dataset.assignedBy;
  const assignedTo = draggedEl.dataset.assignedTo;
  const whoAssigned = draggedEl.dataset.whoAssigned;

  if (currentSection === containerId) return null;
  if (currentSection === "other-section" && targetSection === "TASK") return false;

  if (role === "admin") {
    if (currentSection === "task-section" && targetSection === "OTHERS") return false;
    if (currentSection === "other-section" && targetSection === "TASK") return false;
    if (currentSection === "change-section") {
      if (whoAssigned === "admin" && !(targetSection === "TASK" || targetSection === "UPDATE")) return false;
      if (whoAssigned === "user" && !(targetSection === "OTHERS" || targetSection === "UPDATE")) return false;
    }
    if (currentSection === "update-section") {
      if (whoAssigned === "admin" && !(targetSection === "TASK" || targetSection === "CHANGES")) return false;
      if (whoAssigned === "user" && !(targetSection === "OTHERS" || targetSection === "CHANGES")) return false;
    }
  } else {
    if (currentSection === "change-section" || currentSection === "update-section") {
      if (targetSection === "TASK" && assignedBy !== assignedTo) return false;
      if (targetSection === "OTHERS" && assignedBy === assignedTo) return false;
    }
    if (currentSection === "task-section" && targetSection === "OTHERS") {
