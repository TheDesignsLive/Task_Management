<!-- home.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Home</title>
<link rel="icon" type="image/svg" href="/images/tms.svg">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
/* ===== PREVENT FULL PAGE SCROLL ===== */
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  overflow: hidden;
  font-family: Arial, sans-serif;
  background-color: #3C3A3A;
}
.layout {
  display: flex;
  height: calc(100% - 60px);
}

.sidebar-container {
  width: 55px;
}

/* Ensure the container inside main-content fills the height */
.main-content > div {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* Content wrapper */
.content-wrapper {
  display: flex;
  flex: 1;
  height: auto;
  align-items: stretch;
}

/* Right section */
.right-section {
  flex: 3;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow-x: visible; 
  overflow-y: auto;   /* ✅ ALLOW vertical scroll */
  min-height: 0;
}

/* Top columns (task containers) */
.top-columns {
  display: flex;
  flex: 1;
  min-width: 1086px;
  align-items: stretch;
  gap: 1px; 
  flex-wrap: nowrap; 
  overflow-x: visible; 
    height: 100%;       /* ✅ IMPORTANT */
  overflow: hidden;
  min-height: 0;
}

/* Allow scroll on hover if content overflows */
 
.completed-section:hover {
  overflow-y: auto;   /* ✅ allow vertical scroll */
  overflow-x: hidden; /* optional */
}

/* ===== TASK SECTIONS VERTICAL SCROLL ===== */
.task-main, 
.task-change, 
.task-update, 
.task-other, 
.completed-section { 
  height: 100%;
  box-sizing: border-box;
  overflow-y: auto; 
  overflow-x: hidden;
       background:#2E2D2D;
       min-height: 0;
}

/* ===== SUB HEADER ===== */
.sub-header {
  display: flex;
  background: #CDF4F4;
  font-size: 14px;
  min-width: 1350px;
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 12px 0;
}

.task-header {
  flex: 1.5;
  display: flex;
  justify-content: center;
}

.change,
.update,
.other-task {
  flex: 1;
  display: flex;
  justify-content: center;
}

.sub-header .vertical-line {
  width: 1px;
  background: #7C7B7B;
}
.sub-header > div {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* ===== LEFT TASK SECTION ===== */
.task-main {
  flex: 1.5;
  padding: 10px;
  overflow-y: auto;
  max-height: 100%;
    overflow-x: hidden;
}
/* Vertical divider */
.vertical-line {
  width: 1px;
  background-color: #7C7B7B;
  height: 100%;
}

/* ===== RIGHT SIDE ===== */
.task-change,
.task-update,
.task-other,
.completed-section {
  flex: 1;
  min-width: 250px;
}

.task-change,
.task-update,
.task-other {
  padding: 10px;
  overflow-y: auto;

  /* 🔥 IMPORTANT FIX */
  height: 100%;
  max-height: 100%;
}
/* ===== COMPLETED SECTION (beside Others) ===== */
.completed-wrapper {
  display: flex;
  flex-direction: column;
  background-color: #2E2D2D;
  border-left: 1px solid #666;
  min-width: 250px;
    min-height: 0; 
}
.completed-section {
  flex: 1;
  padding: 10px;
  overflow-y: auto;
  color: white;
  
}

/* Completed header */
.completed-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-height: 30px;
  height: 30px;
  padding: 0 6px;
  margin: 8px;
  border-radius: 100px;
  background-color: #0F8989;
  font-size: 12px;
  font-weight: 600;
  color: white;
  line-height: 20px;
  box-sizing: border-box;
  padding-left: 12px;
  padding-right: 12px;
  margin-bottom: 0px;
}
/* Dustbin icon */
#delete-completed {
  cursor: pointer;
  transition: transform 0.2s, fill 0.2s;
  fill: #e74c3c;
}

#delete-completed:hover {
  transform: scale(1.2);
  fill: #c0392b;
}

/* ===== TASK ITEM ===== */
.task-item {
  font-size: 13px;
  padding: 6px;
  margin: 6px 0;
  background-color: #444;
  color: #fff;
  border-radius: 4px;
  cursor: pointer;
  transition: background 0.2s;
  overflow: visible; 
  position: relative;
}

@keyframes shimmer {
  0% { background-position: -400px 0; }
  100% { background-position: 400px 0; }
}
.task-skeleton {
  height: 34px;
  margin: 6px 0;
  border-radius: 4px;
  background: linear-gradient(90deg, #3a3a3a 25%, #444 50%, #3a3a3a 75%);
  background-size: 800px 100%;
  animation: shimmer 1.2s infinite linear;
}
.task-item.dragging { opacity: 0.4; border: 2px dashed #0F8989; background: #2a4a4a !important; }
.task-main:hover, .task-change:hover, .task-update:hover, .task-other:hover {
  box-shadow: inset 0 0 0 2px rgba(15,137,137,0.18);
  transition: box-shadow 0.15s;
}
.completed-task { opacity: 0.6; cursor: default; }

.task-checkbox {
  width: 12px; height: 12px;
  appearance: none;
  border: 2px solid white; 
  border-radius: 3px;
  background: transparent;
  cursor: pointer;
  position: relative;
  flex-shrink: 0;  
}

.task-checkbox:checked::after {
  content: "✔";                
  position: absolute;
  top: 0;
  left: 1px;
  font-size: 7px;
  color: white;                
}

.priority-red { border-color: #ff4d4d; }
.priority-yellow { border-color: #ffd633; }
.priority-blue { border-color: #4da6ff; }

.info-icon { width: 14px; height: 14px; stroke: #959494; flex-shrink: 0; margin-left: auto; }
.info-icon:hover { stroke:white; }

.task-row { display: flex; align-items: center; gap: 6px; }
.task-title { flex: 1; min-width: 0; word-break: break-word; }
.task-name { flex: 0 1 auto; font-size: 11px; opacity: 0.7; max-width: 80px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.task-date { flex: 0 0 50px; font-size: 11px; opacity: 0.8; white-space: nowrap; text-align: center; }

/* 3 DOT MENU */
.dots-btn{
  cursor:pointer;
  padding:2px 6px;
  color:#959494;
  font-size:14px;
  margin-left:auto;
  border-radius:4px;
  transition:background 0.15s,color 0.15s;
}

.dots-btn:hover{
  background:#666;
  color:white;
}

.task-options-menu{
  display:none;
  position:absolute;
  right:5px;
  top:28px;     /* open downward */
  background:white;
  color:#333;
  border-radius:8px;
  box-shadow:0 8px 20px rgba(0,0,0,0.35);
  z-index:2000;
  min-width:110px;
  overflow:hidden;
  animation:menuPopDown 0.15s ease;
}

.task-options-menu div{
  padding:8px 12px;
  font-size:12px;
  cursor:pointer;
  display:flex;
  align-items:center;
  gap:8px;
}

.task-options-menu div:hover{
  background:#f2f2f2;
}

@keyframes menuPopDown{
  from{
    opacity:0;
    transform:translateY(-6px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

.task-options-menu div { padding: 8px 12px; font-size: 12px; cursor: pointer; display: flex; align-items: center; gap: 8px; }
.task-options-menu div:hover { background-color: #f0f0f0; }

/* EDIT BOX */
.edit-box {
  display: none;
  background: #555;
  padding: 10px;
  border-radius: 4px;
  margin-top: 5px;
  flex-direction: column;
  gap: 8px;
  box-sizing: border-box;
}

.edit-box input, .edit-box textarea, .edit-box select {
  background: #3C3A3A; color: white; border: 1px solid #7C7B7B;
  padding: 5px; border-radius: 4px; font-size: 12px;
  box-sizing: border-box;
}

.edit-box input.edit-title, .edit-box textarea.edit-desc {
  width: 100% !important;
  display: block;
}

.edit-box textarea.edit-desc {
  min-height: 80px;
  resize: none;
  overflow: hidden;
  line-height: 1.5;
}

.edit-actions { display: flex; gap: 10px; justify-content: flex-end; }
.save-btn { background: #0F8989; color: white; border: none; padding: 5px 12px; border-radius: 4px; cursor: pointer; }
.cancel-btn { background: #7C7B7B; color: white; border: none; padding: 5px 12px; border-radius: 4px; cursor: pointer; }

/* DESCRIPTION DETAILS */
.task-details { display: none; padding-top: 8px; border-top: 1px solid #666; margin-top: 8px; font-size: 12px; }
.task-desc-text { color: #ccc; line-height: 1.4; margin-bottom: 8px; }
.task-item.expanded .task-details { display: block; }

/* MODAL */
.modal {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  justify-content: center;
  align-items: center;
}

.modal-content {
  background: white;
  padding: 25px;
  border-radius: 10px;
  width: 320px;
  text-align: center;
  animation: pop 0.3s ease;
}

.modal-content h3 { color: #d32f2f; margin-bottom: 10px; }

.modal-buttons { margin-top: 20px; display: flex; justify-content: space-between; }
.btn { padding: 8px 15px; border: none; border-radius: 6px; cursor: pointer; transition: 0.2s; }
.cancel { background: #ccc; }
.cancel:hover { background: #aaa; }
.delete { background: #d32f2f; color: white; }
.delete:hover { background: #b71c1c; }

@keyframes pop {
  from { transform: scale(0.7); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* ==== BOARD SCROLL CONTAINERS ==== */
.main-content { flex:1; overflow:hidden; 
  display: flex;
  flex-direction: column;}
.board-scroll {
  width: 100%;
  height: 100%;
  overflow-x: auto;   /* ✅ must be auto */
  overflow-y: hidden;
    display: flex;
}
.board-container {
  width: max-content;   /* 🔥 Keeps columns proper width when zoomed in */
  min-width: 100%;      /* ✅ FIX: Forces container to fill the screen when zoomed out */
  height: 100%;
  display: flex;
  flex-direction: column;
}

.sub-header > div {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12px;
  box-sizing: border-box;
}
.sub-header-inner {
  display: flex;
  gap: 20px;
}
.other-task .task-text {
  padding-right: 50px;
}

/* TRUE LOGO: calendar style for task-date */
.flatpickr-calendar.task-calendar {
  margin-top: 0 !important;
  width: 330px !important;
  border-radius: 16px;
  border: none;
  box-shadow: 0 12px 30px rgba(0,0,0,0.12);
  font-family: Segoe UI, sans-serif;
}

/* TRUE LOGO: FORCE FLATPICKR ALWAYS OPEN AT TOP CENTER */
.flatpickr-calendar.task-calendar.open {
  position: fixed !important;
  top: 190px !important;
  left: 60% !important;
  right: 20px !important;
  transform: translateX(-50%) !important;
  bottom: auto !important;
}

.flatpickr-months .flatpickr-month { height: 32px !important; }
.flatpickr-weekdays { font-size: 10px !important; }
.flatpickr-days { width: 100% !important; }
.numInputWrapper input { font-size: 12px !important; }

.past-date {
  color: #ff4d4d !important;
  font-weight:500;
}

.center-calendar {
  position: fixed !important;
  top: 20% !important;
  left: 60% !important;
  transform: translateX(-50%) !important;
  z-index: 10000 !important;
}

.flatpickr-calendar {
  font-size: 12px;
  width: 280px !important;
  border-radius: 12px;
}

.flatpickr-monthDropdown-months {
  background: transparent !important;
  color: white !important;
  border: none !important;
  outline: none !important;
  appearance: none;
  -webkit-appearance: none;
  font-weight: 600;
  padding: 2px 4px !important;
}

.flatpickr-monthDropdown-months option {
  background-color: white !important;
  color: #333 !important;
}

.flatpickr-current-month .numInputWrapper input.cur-year {
  color: white !important;
  background: transparent !important;
  font-weight: 600;
}

.flatpickr-day { height: 30px; line-height: 30px; font-size: 12px; }
.flatpickr-weekday { font-size: 11px; }
.flatpickr-current-month { font-size: 13px; color: white !important; }
.flatpickr-months { background: linear-gradient(to right, #0f9d9a, #14b8a6); border-radius: 12px 12px 0 0; }
.flatpickr-prev-month, .flatpickr-next-month { color: white !important; fill: white !important; }

.content-wrapper {
  display: flex;
  flex: 1 1 0;
  align-items: stretch;
  height: 100%;
    min-height: 0;   /* 🔥 VERY IMPORTANT */
}

.board-container {
  display: flex;
  flex-direction: column;
  height: 100%;
}



/* ===== CUSTOM SCROLLBAR ===== */

/* scrollbar size */
::-webkit-scrollbar{
  width:2px;
  height:6px;
}

/* scrollbar track */
::-webkit-scrollbar-track{
  background:transparent;
}

/* scrollbar thumb */
::-webkit-scrollbar-thumb{
  background:#777;
  border-radius:10px;
}

/* hover effect */
::-webkit-scrollbar-thumb:hover{
  background:#aaa;
}


/* TASK column bigger */
.task-column{
  position:sticky;
  left:0;
  z-index:4;
  background:#3C3A3A;
  display:flex;
  flex-direction:column;
  flex:1.5;
  min-width:400px;
}

/* other columns normal */
.column-wrapper{
  display:flex;
  flex-direction:column;
  flex:1;
  min-width:250px;
}
.completed-wrapper{
  display:flex;
  flex-direction:column;
  min-width:250px;
  height: 100%;   
  flex: 1;        /* ✅ FIX: Allows completed column to stretch avoiding dark gaps */
}
.drop-active {
  background: rgba(15,137,137,0.07) !important;
  box-shadow: inset 0 0 0 2px rgba(15,137,137,0.4);
  transition: background 0.15s, box-shadow 0.15s;
}

/* HEADER STYLE */
.column-header{
  height:30px;
  margin:8px;
  margin-bottom:0;
  border-radius:100px;
  background:#0F8989;
  color:white;
  font-size:12px;
  font-weight:600;
  display:flex;
  align-items:center;
  justify-content:center;
}

/* SECTION AREA */
.task-column .task-main,
.column-wrapper .task-change,
.column-wrapper .task-update,
.column-wrapper .task-other{
  flex:1;
  padding:10px;
  overflow-y:auto;
}


/* COMPLETED TASK MENU */
.completed-menu{
  display:none;
  position:absolute;
  right:5px;
  bottom:28px;   /* open upward */
  background:white;
  color:#333;
  border-radius:8px;
  box-shadow:0 8px 20px rgba(0,0,0,0.35);
  z-index:2000;
  min-width:110px;
  overflow:hidden;
  animation:menuPopUp 0.15s ease;
    bottom: -8px;     /* reset */
}

.completed-menu div{
  padding:8px 12px;
  font-size:12px;
  cursor:pointer;
  display:flex;
  align-items:center;
  gap:8px;
}

.completed-menu div:hover{
  background:#f2f2f2;
}

/* animation */
@keyframes menuPopUp{
  from{
    opacity:0;
    transform:translateY(6px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

/* ===== MULTI SELECT ===== */
.task-item.selected {
  background-color: #1a4a4a !important;
  border-left: 3px solid #0F8989;
  outline: 1px solid #0F8989;
}
.task-item.selected:hover { background-color: #1e5555 !important; }

#multi-select-bar {
  display: none;
  position: fixed;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  background: #0F8989;
  color: white;
  padding: 8px 18px;
  border-radius: 100px;
  font-size: 12px;
  font-weight: 700;
  z-index: 8000;
  box-shadow: 0 4px 16px rgba(0,0,0,0.4);
  gap: 12px;
  align-items: center;
  white-space: nowrap;
}
#multi-select-bar.visible { display: flex; }
#multi-select-bar button {
  background: rgba(255,255,255,0.15);
  border: none; color: white;
  padding: 4px 10px; border-radius: 20px;
  font-size: 11px; cursor: pointer; font-weight: 600;
}
#multi-select-bar button:hover { background: rgba(255,255,255,0.3); }

/* CONTEXT MENU */
#task-context-menu {
  display: none;
  position: fixed;
  background: #ffffff;
  border-radius: 14px;
  box-shadow: 0 12px 40px rgba(0,0,0,0.22), 0 2px 8px rgba(0,0,0,0.10);
  z-index: 99999;
  min-width: 210px;
  overflow: visible;
  animation: ctxMenuPop 0.18s cubic-bezier(.34,1.56,.64,1);
  border: 1px solid rgba(0,0,0,0.07);
  padding: 6px 0;
}

@keyframes ctxMenuPop {
  from { opacity: 0; transform: scale(0.88) translateY(-8px); }
  to   { opacity: 1; transform: scale(1)    translateY(0); }
}

#task-context-menu .ctx-section {
  padding: 2px 0;
  border-bottom: 1px solid #f0f0f0;
}
#task-context-menu .ctx-section:last-child { border-bottom: none; }

#task-context-menu .ctx-label {
  padding: 6px 16px 3px;
  font-size: 10px;
  color: #aaa;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.7px;
}

#task-context-menu .ctx-item {
  padding: 9px 16px;
  font-size: 13px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #222;
  transition: background 0.1s, color 0.1s;
  border-radius: 0;
  position: relative;
}
#task-context-menu .ctx-item:hover { background: #f0fafa; color: #0F8989 !important; font-weight: 700; }
#task-context-menu .ctx-item:hover span { color: #0F8989 !important; }
#task-context-menu .ctx-item.danger:hover { background: #fff0f0 !important; color: #b71c1c !important; font-weight: 700; }
#task-context-menu .ctx-item.danger:hover span { color: #b71c1c !important; }
#task-context-menu .ctx-item.danger { color: #d32f2f; }
#task-context-menu .ctx-item.danger:hover { background: #fff0f0; color: #b71c1c; }
#task-context-menu .ctx-item i { width: 16px; text-align: center; font-size: 13px; }

/* Icon row for date */
.ctx-icon-row {
  display: flex;
  gap: 2px;
  padding: 4px 8px 6px;
  justify-content: space-between;
}

.ctx-icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 6px 4px 5px;
  border-radius: 8px;
  cursor: pointer;
  min-width: 32px;
  transition: background 0.15s;
  color: #555;
}
.ctx-icon-btn i { font-size: 14px; line-height: 1; }
.ctx-icon-btn span { font-size: 9px; font-weight: 600; white-space: nowrap; color: #888; }
.ctx-icon-btn:hover { background: #f0fafa; }
.ctx-icon-btn:hover i { color: #0F8989; }
.ctx-icon-btn:hover span { color: #0F8989; }

/* Calendar icon with number (7d / 1 Month) */
.ctx-cal-icon { color: #555; }
.ctx-cal-num { color: #555; }
.ctx-icon-btn:hover .ctx-cal-icon { color: #0F8989; }
.ctx-icon-btn:hover .ctx-cal-num { color: #0F8989; }

/* Clear date red */
.ctx-icon-clear-date i { color: #ccc; }
.ctx-icon-clear-date:hover { background: #fff0f0 !important; }
.ctx-icon-clear-date:hover i { color: #e74c3c !important; }
.ctx-icon-clear-date:hover span { color: #e74c3c !important; }

/* Priority flags */
.ctx-flag-high i  { color: #e74c3c; }
.ctx-flag-medium i{ color: #f39c12; }
.ctx-flag-low i   { color: #3498db; }
.ctx-flag-none i  { color: #ccc; }
.ctx-flag-high:hover  { background: #fff0f0 !important; }
.ctx-flag-medium:hover{ background: #fffbf0 !important; }
.ctx-flag-low:hover   { background: #f0f4ff !important; }
.ctx-flag-none:hover  { background: #f5f5f5 !important; }

/* Selected info */
.ctx-item-selected-info {
  color: #0F8989 !important;
  font-size: 11px !important;
  padding: 6px 16px !important;
  cursor: default !important;
  font-weight: 700;
  background: #f0fafa;
}
.ctx-item-selected-info:hover { background: #f0fafa !important; color: #0F8989 !important; }

/* Submenu arrow */
.ctx-item .ctx-arrow {
  margin-left: auto;
  font-size: 11px;
  color: #bbb;
}

/* Priority inline icon row */
.ctx-priority-row {
  display: flex;
  gap: 4px;
  padding: 4px 10px 8px;
  justify-content: flex-start;
}
.ctx-priority-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 7px 10px 6px;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.15s;
  flex: 1;
}
.ctx-priority-btn span { font-size: 9px; font-weight: 700; color: #888; }
.ctx-priority-btn i { font-size: 16px; }
.ctx-priority-btn:hover span { color: inherit; }
.ctx-priority-btn.p-high i  { color: #e74c3c; }
.ctx-priority-btn.p-medium i{ color: #f39c12; }
.ctx-priority-btn.p-low i   { color: #3498db; }
.ctx-priority-btn.p-high:hover  { background:#fff0f0; }
.ctx-priority-btn.p-medium:hover{ background:#fffbf0; }
.ctx-priority-btn.p-low:hover   { background:#f0f4ff; }

.ctx-delete-btn { font-weight: 700 !important; }

body.no-select { user-select: none; -webkit-user-select: none; }

/* Bulk delete modal */
#ctx-delete-confirm {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  z-index: 999999;
  align-items: center;
  justify-content: center;
  animation: ctxFadeIn 0.18s ease;
}
@keyframes ctxFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}



/* Invalid drop target */
.drop-invalid {
  background: rgba(220, 53, 69, 0.08) !important;
  box-shadow: inset 0 0 0 2px rgba(220, 53, 69, 0.5);
  transition: background 0.15s, box-shadow 0.15s;
}

.drop-invalid-overlay {
  position: sticky;
  bottom: 50%;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 36px;
  pointer-events: none;
  z-index: 100;
  opacity: 0.7;
  user-select: none;
}

</style>
</head>
<body>
  <%- include('navbar') %>

  <div class="layout">
    <div class="sidebar-container">
      <%- include('sidebar') %>
    </div>

    <div class="main-content">
      <div class="board-scroll">
        <div class="board-container">
         
<div class="content-wrapper">

  <div class="task-column">
    <div class="column-header">Task</div>
    <div class="task-main" id="task-section"></div>
  </div>

  <div class="vertical-line"></div>

  <div class="right-section">
    <div class="top-columns">

<div class="column-wrapper">
        <div class="column-header" id="header-changes">Change</div>
        <div class="task-change" id="change-section"></div>
      </div>

      <div class="vertical-line"></div>

      <div class="column-wrapper">
        <div class="column-header" id="header-update">Update</div>
        <div class="task-update" id="update-section"></div>
      </div>

      <div class="vertical-line"></div>

      <div class="column-wrapper">
        <div class="column-header">Others</div>
        <div class="task-other" id="other-section"></div>
      </div>

      <div class="completed-wrapper">
        <div class="completed-header">
          Completed Tasks
          <svg id="delete-completed" viewBox="0 0 24 24" width="20" height="20">
            <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
          </svg>
        </div>
        <div class="completed-section" id="completed-section"></div>
