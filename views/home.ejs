// Section move
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('#task-context-menu .ctx-item[data-action^="section-"]').forEach(item => {
    item.addEventListener('click', async (e) => {
      e.stopPropagation();
      hideContextMenu();
      const section = item.dataset.action.replace('section-', '');
      const ids = [...selectedTaskIds];
      if (!ids.length) return;
      await fetch('/api/bulk-update-section', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids, section })
      });
      clearSelection();
      await refreshTasksUI();
    });
  });
});

// Delete btn → show modal
document.addEventListener('DOMContentLoaded', () => {
  document.querySelector('.ctx-delete-btn').addEventListener('click', (e) => {
    e.stopPropagation();
    hideContextMenu();
    const ids = [...selectedTaskIds];
    if (!ids.length) return;
    const count = ids.length;
    document.getElementById('ctx-delete-count').textContent =
      `${count} task${count > 1 ? 's' : ''} will be permanently removed.`;
    document.getElementById('ctx-delete-confirm').style.display = 'flex';
  });

  document.getElementById('ctx-delete-cancel').addEventListener('click', () => {
    document.getElementById('ctx-delete-confirm').style.display = 'none';
  });

  //
// ── Mark as Done ──
  document.querySelector('.ctx-done-btn').addEventListener('click', async (e) => {
    e.stopPropagation();
    hideContextMenu();
    const ids = [...selectedTaskIds];
    if (!ids.length) return;
    await Promise.all(ids.map(id =>
      fetch('/update-task-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, status: 'COMPLETED', section: 'COMPLETED' })
      })
    ));
    clearSelection();
    await refreshTasksUI();
    showToast('Tasks marked as done');
  });
  //

  document.getElementById('ctx-delete-ok').addEventListener('click', async () => {
    document.getElementById('ctx-delete-confirm').style.display = 'none';
    const ids = [...selectedTaskIds];
    await fetch('/api/bulk-delete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids })
    });
    clearSelection();
    await refreshTasksUI();
  });
});

document.addEventListener('DOMContentLoaded', () => {
  const msClearBtn = document.getElementById('ms-clear-btn');
  if (msClearBtn) {
    msClearBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();
      selectedTaskIds.clear();
      lastClickedTaskEl = null;
      document.body.classList.remove('no-select');
      getAllVisibleTaskEls().forEach(el => el.classList.remove('selected'));
      document.getElementById('multi-select-bar').classList.remove('visible');
    });
  }
});

// ✅ ONLY APPLY HORIZONTAL SCROLL ON BOARD (NOT INSIDE TASK COLUMNS)
const board = document.querySelector('.board-scroll');

board.addEventListener('wheel', function(e) {

  const isInsideColumn = e.target.closest(
    '.task-main, .task-change, .task-update, .task-other, .completed-section'
  );

  // ✅ If mouse is inside any column → allow normal vertical scroll
  if (isInsideColumn) return;

  // ✅ Otherwise → do horizontal scroll
  e.preventDefault();
  board.scrollLeft += e.deltaY;

}, { passive: false });
