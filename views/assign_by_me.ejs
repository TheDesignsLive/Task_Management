function openEdit(id) {
    document.querySelectorAll('.edit-box').forEach(e => e.style.display = 'none');

    const box = document.getElementById(`edit-${id}`);
    box.style.display = 'flex';

    const dateInputId = `date-${id}`;
    initCalendar(dateInputId); // 🔥 important
}


function closeEdit(id) {
    document.getElementById(`edit-${id}`).style.display = 'none';
}

async function saveEdit(id) {
    const title = document.getElementById(`title-${id}`).value;
    const description = document.getElementById(`desc-${id}`).value;
    const priority = document.getElementById(`priority-${id}`).value;
   const due_date_input = document.getElementById(`date-${id}`).value;

const due_date = due_date_input === "" ? null : due_date_input;

    try {
        await fetch('/assign_by_me/edit-task', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, title, description, priority, due_date })
        });
    } catch (err) {
        console.error(err);
    }

    closeEdit(id);
}

let calendars = {};


function initCalendar(inputId) {

    // 🔥 destroy old instance (important)
    if (calendars[inputId]) {
        calendars[inputId].destroy();
    }

    const input = document.getElementById(inputId);
    const currentValue = input.value;

    calendars[inputId] = flatpickr(input, {
        dateFormat: "Y-m-d",
        defaultDate: currentValue || null,
        allowInput: true,
        clickOpens: true,

        // ✅ prevent past date but allow editing backward
        minDate: "today"
    });
}

function quickEditDate(taskId, currentDate) {
    const inputId = `quick-date-${taskId}`;
    const input = document.getElementById(inputId);

    // destroy old calendar if exists
    if (calendars[inputId]) {
        calendars[inputId].destroy();
    }

    calendars[inputId] = flatpickr(input, {
        dateFormat: "Y-m-d",
        defaultDate: currentDate || null,
        minDate: "today",   // ❌ no past date
        clickOpens: false,

        onChange: async function(selectedDates, dateStr) {
            try {
                await fetch('/assign_by_me/edit-task', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id: taskId,
                        title: null,
                        description: null,
                        priority: null,
                        due_date: dateStr
                    })
                });
            } catch (err) {
                console.error(err);
            }
        }
    });

    calendars[inputId].open();
}

function formatInputDate(dateStr) {
    const d = new Date(dateStr);

    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');

    return `${year}-${month}-${day}`;
}


function openCalendar(inputId) {
    initCalendar(inputId);
    calendars[inputId].open();
}

// Init ABM context menu button listeners
document.addEventListener('DOMContentLoaded', () => {
    abmCtxMenu = document.getElementById('abm-context-menu');

    // Date icon buttons
    document.querySelectorAll('#abm-context-menu .ctx-icon-btn').forEach(btn => {
        btn.addEventListener('mousedown', (e) => { e.preventDefault(); e.stopPropagation(); });
        btn.addEventListener('click', (e) => {
            e.preventDefault(); e.stopPropagation();
            abmHandleDateAction(btn.dataset.action);
        });
    });

    // Priority buttons
    document.querySelectorAll('#abm-context-menu .ctx-priority-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            abmBulkUpdatePriority(btn.dataset.priority);
        });
    });

// Mark as done
    document.getElementById('abm-ctx-done-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        abmBulkMarkDone();
    });

    // Mark as incomplete
    document.getElementById('abm-ctx-undone-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        abmBulkMarkUndone();
    });

    // Delete
    document.getElementById('abm-ctx-delete-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        abmHideContextMenu();
        const ids = [...abmSelectedIds];
        if (!ids.length) return;
        const count = ids.length;
        document.getElementById('abm-delete-count').textContent =
            `${count} task${count > 1 ? 's' : ''} will be permanently removed.`;
        document.getElementById('abm-delete-confirm').style.display = 'flex';
    });

    document.getElementById('abm-delete-cancel').addEventListener('click', () => {
        document.getElementById('abm-delete-confirm').style.display = 'none';
    });

    document.getElementById('abm-delete-ok').addEventListener('click', async () => {
        await abmBulkDelete();
    });
});
</script>
