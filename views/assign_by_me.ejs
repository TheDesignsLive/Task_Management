<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Assign By Me</title>
<link rel="icon" type="image/svg" href="/images/tms.svg">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<style>
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; font-family: Arial, sans-serif; background-color: #3C3A3A; }
.layout { display: flex; height: calc(100vh - 60px); } /* Changed to 100vh for stricter height control */
.sidebar-container { width: 55px; flex-shrink: 0; }

/* ✅ THE FIX: Added min-height: 0 to all flex columns in the chain */
.main-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-height: 0; }
.content-wrapper { flex: 1; display: flex; gap: 10px; padding: 10px; overflow: hidden; min-height: 0; }

.task-column { flex: 1; display: flex; flex-direction: column; background-color: rgba(255,255,255,0.05); border-radius: 8px; position: relative; min-height: 0; overflow: hidden; }
#open-task-col { z-index: 2; }
#comp-task-col { z-index: 1; }

.column-header { border-radius: 100px; background-color: #0F8989; padding: 6px 15px; font-weight: bold; color: white; font-size: 13px; margin: 5px; text-align: center; position: relative; flex-shrink: 0; }

/* ✅ THE FIX: This container now forces the scrollbar */
.task-list-container { flex: 1; overflow-y: auto; padding: 5px 10px; min-height: 0; }

.task-item { font-size: 13px; padding: 6px; margin: 6px 0; background-color: #444; color: #fff; border-radius: 4px; transition: background 0.2s; }
.task-item:hover { background-color: #555; }
.completed-task { opacity: 0.6; background-color: #2E2D2D; }
.task-row { display: flex; align-items: center; gap: 10px; position: relative; min-height: 28px; flex-wrap: nowrap; }
.task-title { flex: 1; min-width: 0; word-break: break-word; align-self: center; line-height: 1.3; font-size: 13px; }
.task-desc { flex: 1.5; min-width: 0; word-break: break-word; font-size: 11px; opacity: 0.8; align-self: center; }
.task-sec-val { flex: 0 0 55px; font-size: 10px; font-weight: bold; text-align: center; background: #ddd; border-radius: 4px; padding: 0 4px; color: #333; white-space: nowrap; width: 55px; overflow: hidden; text-overflow: ellipsis; align-self: center; height: 20px; line-height: 20px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; flex-shrink: 0; }
.task-assign { flex: 0 0 115px; min-width: 0; text-align: center; align-self: center; display: flex; align-items: center; justify-content: center; height: 20px; box-sizing: border-box; flex-shrink: 0; }
.task-date { flex: 0 0 38px; font-size: 10px; opacity: 0.7; text-align: right; white-space: nowrap; align-self: center; line-height: 20px; height: 20px; display: flex; align-items: center; justify-content: flex-end; flex-shrink: 0; cursor: pointer; }
.task-date.past-date { color: #e24c4c !important; opacity: 1; }
.task-info-icon { flex-shrink: 0; cursor: pointer; color: #aaa; display: flex; align-items: center; justify-content: center; width: 16px; height: 16px; align-self: center; margin: 0; padding: 0; }
.task-info-icon:hover { color: white; stroke: white; }
.desc-tooltip { display: none; }
.task-item.abm-expanded .abm-task-details { display: block !important; }
.task-checkbox { width: 12px; height: 12px; appearance: none; border: 2px solid white; border-radius: 3px; background: transparent; cursor: pointer; position: relative; flex-shrink: 0; align-self: center; margin-top: 0; }
.task-checkbox:checked::after { content: "✔"; position: absolute; top: 0; left: 1px; font-size: 7px; color: white; }
.priority-HIGH { border-color: #ff4d4d; }
.priority-MEDIUM { border-color: #ffd633; }
.priority-LOW { border-color: #4da6ff; }

#delete-completed { position: absolute; right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; transition: transform 0.2s, fill 0.2s; fill: #e74c3c; }
.dots-btn { cursor: pointer; padding: 0 4px; color: #959494; font-size: 14px; margin-left: 0; align-self: center; display: flex; align-items: center; justify-content: center; height: 20px; width: 18px; flex-shrink: 0; }
.task-options-menu { display: none; position: absolute; right: 25px; top: 25px; background: white; color: #333; border-radius: 6px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); z-index: 10000; min-width: 100px; }
.task-options-menu div { padding: 8px 12px; font-size: 12px; cursor: pointer; display: flex; align-items: center; gap: 8px; }
.modal { display: none; position: fixed; z-index: 99999; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); justify-content: center; align-items: center; }
.modal-content { background: white; padding: 25px; border-radius: 10px; width: 320px; text-align: center; color: #333; }
.btn { flex: 1; padding: 8px 15px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; }
.cancel { background: #ccc; }
.delete { background: #d32f2f; color: white; }

/* ===== SCROLLBAR ===== */
::-webkit-scrollbar { width: 3px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #777; border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: #aaa; }

/* ===== CUSTOM HOVER DROPDOWN ===== */


.custom-select-btn::after { content: "▼"; font-size: 8px; margin-left: 4px; color: white; }

.custom-menu-item:hover { background-color: #f0f0f0; }


/* ALWAYS OPEN STRICTLY TO THE RIGHT */

.custom-menu-item.has-submenu:hover > .custom-submenu { display: block; }




.assign-by-me-page .custom-dropdown { 
  position: relative; 
  display: inline-block; 
  width: 100%; 
  text-align: left; 
}
.assign-by-me-page .custom-select-btn { 
  background-color: #555; 
  color: white; 
  border: 1px solid #666; 
  border-radius: 16px; 
  padding: 0 10px 0 8px; 
  cursor: pointer; 
  font-size: 11px; 
  width: 100%; 
  max-width: 110px;
  box-sizing: border-box;
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  white-space: nowrap; 
  overflow: hidden; 
  text-overflow: ellipsis;
  height: 20px;
  line-height: 20px;
}

.assign-by-me-page .custom-select-btn::after { 
  content: "▼"; 
  font-size: 8px; 
  margin-left: 4px; 
  color: white; 
}

.assign-by-me-page .custom-menu {
  display: none; 
  position: absolute; 
  background: white; 
  color: #333;
  min-width: 160px; 
  box-shadow: 0 4px 15px rgba(0,0,0,0.4); 
  border-radius: 6px; 
  z-index: 10000;
  padding: 5px 0; 
  font-size: 12px; 
  margin-top: 3px;
}

.assign-by-me-page .custom-menu-item { 
  position: relative; 
  padding: 8px 15px; 
  cursor: pointer; 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  white-space: nowrap; 
  transition: background 0.2s; 
}

.assign-by-me-page .custom-menu-item:hover { 
  background-color: #f0f0f0; 
}

.assign-by-me-page .has-submenu::after { 
  content: "▶"; 
  font-size: 9px; 
  color: #888; 
  margin-left: 10px; 
}

.assign-by-me-page .custom-submenu {
  display: none; 
  position: absolute; 
  top: 0; 
  left: 100%; 
  background: white; 
  min-width: 150px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.4); 
  border-radius: 6px; 
  padding: 5px 0; 
  margin-left: 1px; 
  z-index: 10001;
}

.assign-by-me-page .custom-menu-item.has-submenu:hover > .custom-submenu { 
  display: block; 
}

.assign-by-me-page .menu-divider { 
  border-bottom: 1px solid #ddd; 
  margin: 4px 0; 
}

/* ===== EDIT BOX DESIGN ===== */
.edit-box {
    background: #2b2b2b;
    border: 1px solid #555;
    border-radius: 8px;
    margin-top: 6px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    animation: fadeSlide 0.2s ease;
}

.edit-box input,
.edit-box textarea,
.edit-box select {
    width: 100%;
    padding: 6px 8px;
    border-radius: 5px;
    border: 1px solid #666;
    background: #3a3a3a;
    color: white;
    font-size: 12px;
    outline: none;
}

.edit-box textarea {
    resize: vertical;
    min-height: 50px;
}

.edit-box input:focus,
.edit-box textarea:focus,
.edit-box select:focus {
    border-color: #0F8989;
}

/* Buttons */
.edit-actions {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
}

.edit-actions button {
    padding: 5px 10px;
    border-radius: 5px;
    border: none;
    font-size: 12px;
    cursor: pointer;
}

.btn-save {
    background: #0F8989;
    color: white;
}

.btn-cancel {
    background: #777;
    color: white;
}

/* Animation */
@keyframes fadeSlide {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
    .task-row {
        flex-wrap: wrap;
        gap: 4px;
    }

    .task-title,
    .task-desc {
        flex: 100%;
    }

    .task-assign,
    .task-date {
        flex: 48%;
    }
}


/* ===== EDIT BOX MODERN UI ===== */
.edit-box {
  display: none;
  background: #555;
  padding: 10px;
  border-radius: 6px;
  margin-top: 6px;
  flex-direction: column;
  gap: 8px;
  animation: fadeIn 0.2s ease;
}

/* inputs */
.edit-box input,
.edit-box textarea,
.edit-box select {
  background: #3C3A3A;
  color: white;
  border: 1px solid #777;
  padding: 6px;
  border-radius: 4px;
  font-size: 12px;
  width: 100%;
}

/* textarea auto height */
.edit-desc {
  min-height: 70px;
  resize: none;
  line-height: 1.4;
}

/* row (priority + date) */
.edit-row {
  display: flex;
  gap: 6px;
}

.edit-row select,
.edit-row input {
  flex: 1;
}

/* buttons */
.edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}

.save-btn {
  background: #0F8989;
  color: white;
  border: none;
  padding: 5px 12px;
  border-radius: 4px;
  cursor: pointer;
}

.save-btn:hover {
  background: #0c6f6f;
}

.cancel-btn {
  background: #777;
  color: white;
  border: none;
  padding: 5px 12px;
  border-radius: 4px;
  cursor: pointer;
}

.cancel-btn:hover {
  background: #555;
}

/* animation */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-5px); }
  to { opacity: 1; transform: translateY(0); }
}

/* 📱 RESPONSIVE */
@media (max-width: 768px) {
  .task-row {
    flex-wrap: wrap;
  }

  .task-title, .task-desc {
    flex: 100%;
  }

  .edit-row {
    flex-direction: column;
  }
}

.date-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

/* ===== MULTI SELECT ===== */
.task-item.selected {
  background-color: #1a4a4a !important;
  border-left: 3px solid #0F8989;
  outline: 1px solid #0F8989;
}
.task-item.selected:hover { background-color: #1e5555 !important; }

body.no-select { user-select: none; -webkit-user-select: none; }

/* CONTEXT MENU */
#abm-context-menu {
  display: none;
  position: fixed;
  background: #2E2D2D;
  border-radius: 14px;
  border: 1px solid #0F8989;
  border-top: 3px solid #0F8989;
  box-shadow: 0 12px 40px rgba(0,0,0,0.22), 0 2px 8px rgba(0,0,0,0.10);
  z-index: 999999;
  min-width: 210px;
  overflow: visible;
  animation: abmCtxPop 0.18s cubic-bezier(.34,1.56,.64,1);
  padding: 6px 0;
}

@keyframes abmCtxPop {
  from { opacity: 0; transform: scale(0.88) translateY(-8px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

#abm-context-menu .ctx-section {
  padding: 2px 0;
  border-bottom: 1px solid #3C3A3A;
}
#abm-context-menu .ctx-section:last-child { border-bottom: none; }

#abm-context-menu .ctx-label {
  padding: 6px 16px 3px;
  font-size: 10px;
  color: #0F8989;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.7px;
}

#abm-context-menu .ctx-item {
  padding: 9px 16px;
  font-size: 13px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #eee;
  transition: background 0.1s, color 0.1s;
  position: relative;
}
#abm-context-menu .ctx-item:hover { background: #f0fafa; color: #0F8989 !important; font-weight: 700; }
#abm-context-menu .ctx-item.danger { color: #e74c3c; font-weight: 700; }
#abm-context-menu .ctx-item.danger:hover { background: #fff0f0 !important; color: #b71c1c !important; }
#abm-context-menu .ctx-item i { width: 16px; text-align: center; font-size: 13px; }

.ctx-item-selected-info {
  color: #0F8989 !important;
  font-size: 11px !important;
  padding: 6px 16px !important;
  cursor: default !important;
  font-weight: 700;
  background: rgba(15,137,137,0.15);
}
.ctx-item-selected-info:hover { background: rgba(15,137,137,0.15) !important; color: #0F8989 !important; }

/* Date icon row */
.ctx-icon-row {
  display: flex;
  gap: 2px;
  padding: 4px 8px 6px;
  justify-content: space-between;
}
.ctx-icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 6px 4px 5px;
  border-radius: 8px;
  cursor: pointer;
  min-width: 32px;
  transition: background 0.15s;
  color: #aaa;
}
.ctx-icon-btn i { font-size: 14px; line-height: 1; color: #aaa; }
.ctx-icon-btn span { font-size: 9px; font-weight: 600; white-space: nowrap; color: #aaa; }
.ctx-icon-btn:hover { background: #f0fafa; }
.ctx-icon-btn:hover i { color: #0F8989; }
.ctx-icon-btn:hover span { color: #0F8989; }

.ctx-cal-icon { color: #555; }
.ctx-cal-num { color: #555; font-size: 7px; font-weight: 800; }
.ctx-icon-btn:hover .ctx-cal-icon { color: #0F8989; }
.ctx-icon-btn:hover .ctx-cal-num { color: #0F8989; }

/* Priority row */
.ctx-priority-row {
  display: flex;
  gap: 4px;
  padding: 4px 10px 8px;
}
.ctx-priority-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 7px 10px 6px;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.15s;
  flex: 1;
}
.ctx-priority-btn span { font-size: 9px; font-weight: 700; color: #aaa; }
.ctx-priority-btn i { font-size: 16px; }
.ctx-priority-btn.p-high i  { color: #e74c3c; }
.ctx-priority-btn.p-medium i{ color: #f39c12; }
.ctx-priority-btn.p-low i   { color: #3498db; }
.ctx-priority-btn.p-high:hover  { background:#fff0f0; }
.ctx-priority-btn.p-medium:hover{ background:#fffbf0; }
.ctx-priority-btn.p-low:hover   { background:#f0f4ff; }

/* Bulk delete modal */
#abm-delete-confirm {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  z-index: 9999999;
  align-items: center;
  justify-content: center;
}

.center-calendar {
  position: fixed !important;
  top: 20% !important;
  left: 50% !important;
  transform: translateX(-50%) !important;
  z-index: 10000 !important;
}

.edit-date {
    width: 100%;
    padding-right: 28px;
    cursor: pointer;
}

.calendar-icon {
    position: absolute;
    right: 8px;
    cursor: pointer;
    font-size: 14px;
}

/* Flatpickr custom theme */
.flatpickr-calendar {
    background: #2b2b2b;
    border-radius: 8px;
    color: white;
}

.flatpickr-day {
    color: white;
}

.flatpickr-day.selected {
    background: #0F8989;
    border: none;
}
</style>
</head>

<body>
<%- include('navbar') %>

<div class="assign-by-me-page">
<div class="layout">
<div class="sidebar-container"><%- include('sidebar') %></div>
<div class="main-content">
<div class="content-wrapper">
  <div class="task-column" id="open-task-col">
    <div class="column-header">Pending Tasks</div>
    <div class="task-list-container" id="open-task-list"></div>
  </div>
  <div class="task-column" id="comp-task-col">
    <div class="column-header">Completed Tasks <svg id="delete-completed" viewBox="0 0 24 24" width="18" height="18"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg></div>
    <div class="task-list-container" id="completed-task-list"></div>
  </div>
</div>
</div>
</div>

<div id="singleDeleteModal" class="modal"><div class="modal-content"><h3>Delete This Task?</h3><div class="modal-buttons"><button id="confirmSingleDelete" class="btn delete">Delete</button><button id="cancelSingleDelete" class="btn cancel">Cancel</button></div></div></div>
<div id="deleteModal" class="modal"><div class="modal-content"><h3>Delete Completed Tasks?</h3><div class="modal-buttons"><button id="confirmDelete" class="btn delete">Delete</button><button id="cancelDelete" class="btn cancel">Cancel</button></div></div></div>

<!-- ABM Right-click context menu -->
<div id="abm-context-menu">
  <div class="ctx-section">
    <div class="ctx-item ctx-item-selected-info" style="pointer-events:none;">
      <i class="fa-solid fa-check-double" style="color:#0F8989;"></i>
      <span id="abm-ctx-selected-label">1 task selected</span>
    </div>
  </div>

  <div class="ctx-section">
    <div class="ctx-label">Change Date</div>
    <div class="ctx-icon-row">
      <div class="ctx-icon-btn" data-action="date-today" title="Today">
        <i class="fa-solid fa-sun"></i>
        <span>Today</span>
      </div>
      <div class="ctx-icon-btn" data-action="date-tomorrow" title="Tomorrow">
        <i class="fa-solid fa-cloud-sun"></i>
        <span>Tom</span>
      </div>
      <div class="ctx-icon-btn" data-action="date-7" title="Next Week">
        <span style="position:relative; display:inline-flex; align-items:center; justify-content:center; width:18px; height:18px;">
          <i class="fa-regular fa-calendar ctx-cal-icon" style="font-size:16px; position:absolute;"></i>
          <span class="ctx-cal-num" style="position:relative; font-size:7px; font-weight:800; margin-top:5px; z-index:1; line-height:1;">7</span>
        </span>
        <span>7d</span>
      </div>
      <div class="ctx-icon-btn" data-action="date-30" title="Next Month">
        <span style="position:relative; display:inline-flex; align-items:center; justify-content:center; width:18px; height:18px;">
          <i class="fa-regular fa-calendar ctx-cal-icon" style="font-size:16px; position:absolute;"></i>
          <span class="ctx-cal-num" style="position:relative; font-size:7px; font-weight:800; margin-top:5px; z-index:1; line-height:1;">1</span>
        </span>
        <span>1 Month</span>
      </div>
      <div class="ctx-icon-btn" data-action="date-custom" title="Pick Date">
        <i class="fa-solid fa-calendar-plus"></i>
        <span>Custom</span>
      </div>
    </div>
    <input type="text" id="abm-ctx-custom-date-input" style="display:none;">
  </div>

  <div class="ctx-section">
    <div class="ctx-label">Change Priority</div>
    <div class="ctx-priority-row">
      <div class="ctx-priority-btn p-high" data-priority="HIGH" title="High">
        <i class="fa-solid fa-flag"></i>
        <span>High</span>
      </div>
      <div class="ctx-priority-btn p-medium" data-priority="MEDIUM" title="Medium">
        <i class="fa-solid fa-flag"></i>
        <span>Medium</span>
      </div>
      <div class="ctx-priority-btn p-low" data-priority="LOW" title="Low">
        <i class="fa-solid fa-flag"></i>
        <span>Low</span>
      </div>
    </div>
  </div>

<div class="ctx-section">
    <div class="ctx-item" id="abm-ctx-done-btn" style="color:#0F8989;">
      <i class="fa-solid fa-circle-check"></i> Mark as Done
    </div>
    <div class="ctx-item" id="abm-ctx-undone-btn" style="color:#f39c12; display:none;">
      <i class="fa-solid fa-rotate-left"></i> Mark as Incomplete
    </div>
  </div>

  <div class="ctx-section">
    <div class="ctx-item danger" id="abm-ctx-delete-btn">
      <i class="fa-solid fa-trash"></i> Delete Selected
    </div>
  </div>
</div>

<!-- ABM Bulk delete confirmation -->
<div id="abm-delete-confirm" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:9999999; align-items:center; justify-content:center;">
  <div style="background:#fff; border-radius:16px; border-top:3px solid #e74c3c; width:300px; padding:28px 24px; font-family:Arial,sans-serif; text-align:center; box-shadow:0 16px 48px rgba(0,0,0,0.22);">
    <div style="width:52px;height:52px;background:#fff0f0;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
      <i class="fa-solid fa-triangle-exclamation" style="color:#e74c3c;font-size:24px;"></i>
    </div>
    <div style="color:#1a1a1a;font-weight:700;font-size:16px;margin-bottom:6px;">Delete Selected Tasks?</div>
    <div id="abm-delete-count" style="color:#888;font-size:13px;margin-bottom:22px;">This cannot be undone.</div>
    <div style="display:flex;gap:10px;justify-content:center;">
      <button id="abm-delete-cancel" style="background:#f0f0f0;color:#444;border:none;padding:10px 24px;border-radius:10px;font-size:13px;cursor:pointer;font-weight:600;">Cancel</button>
