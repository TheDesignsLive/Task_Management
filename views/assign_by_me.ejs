// ✅ FIXED: Detach menu using position: fixed so it cannot be clipped by column borders
let activeMenu = null;
let activeAssignMenu = null;

function toggleMenu(event, id) {
    event.stopPropagation();
    const menu = document.getElementById('menu-' + id);
    const btn = event.currentTarget;
    
    if (activeMenu && activeMenu !== menu) activeMenu.style.display = 'none';
    if (activeAssignMenu) { activeAssignMenu.style.display = 'none'; activeAssignMenu = null; }
    
    if (menu.style.display === 'block') {
        menu.style.display = 'none';
        activeMenu = null;
    } else {
        // Move menu to body to fully escape overflow:hidden columns
        if (menu.parentNode !== document.body) {
            document.body.appendChild(menu);
        }

        menu.style.visibility = 'hidden';
        menu.style.display = 'block';
        menu.style.position = 'fixed';
        menu.style.left = 'auto';
        menu.style.zIndex = '999999';

        const rect = btn.getBoundingClientRect();
        const menuH = menu.offsetHeight || 70;
        const spaceBelow = window.innerHeight - rect.bottom;

        menu.style.right = (window.innerWidth - rect.right) + 'px';

        if (spaceBelow < menuH + 8) {
            menu.style.top = (rect.top - menuH - 4) + 'px';
        } else {
            menu.style.top = (rect.bottom + 4) + 'px';
        }

        menu.style.visibility = 'visible';
        activeMenu = menu;
    }
}

function toggleCustomMenu(event, id) {
    const menu = document.getElementById('assign-menu-' + id);
    const btn = event.currentTarget;

    if (activeAssignMenu && activeAssignMenu !== menu) activeAssignMenu.style.display = 'none';
    if (activeMenu) { activeMenu.style.display = 'none'; activeMenu = null; }
    
    if (menu.style.display === 'block') {
        menu.style.display = 'none';
        activeAssignMenu = null;
    } else {
        const rect = btn.getBoundingClientRect();
        menu.style.position = 'fixed';
        menu.style.left = rect.left + 'px';
        menu.style.zIndex = '99999';

        // Measure menu height before positioning
        menu.style.top = '-9999px';
        menu.style.display = 'block';
        const menuH = menu.offsetHeight || 150;
        const spaceBelow = window.innerHeight - rect.bottom;

        if (spaceBelow < menuH + 8) {
            menu.style.top = (rect.top - menuH - 4) + 'px';
        } else {
            menu.style.top = rect.bottom + 'px';
        }

        activeAssignMenu = menu;
    }
}

// Close all menus when clicking outside
document.addEventListener('click', (e) => { 
    if (!e.target.closest('#abm-context-menu')) {
        if (activeMenu) { activeMenu.style.display = 'none'; activeMenu = null; }
        if (activeAssignMenu) { activeAssignMenu.style.display = 'none'; activeAssignMenu = null; }
    }
});

// =============================================
// ABM MULTI SELECT SYSTEM
// =============================================

let abmSelectedIds = new Set();
let abmLastClickedEl = null;
let abmCtxMenu = null;
let abmCtxMenuOpen = false;

function abmGetAllTaskEls() {
    return Array.from(document.querySelectorAll('.task-item'));
}

function abmUpdateSelectionUI() {
    abmGetAllTaskEls().forEach(el => {
        if (abmSelectedIds.has(el.dataset.id)) {
            el.classList.add('selected');
        } else {
            el.classList.remove('selected');
        }
    });
    if (abmSelectedIds.size === 0) document.body.classList.remove('no-select');
}

function abmClearSelection() {
    abmSelectedIds.clear();
    abmLastClickedEl = null;
    abmUpdateSelectionUI();
    document.body.classList.remove('no-select');
}

function abmSelectTask(el, taskId) {
    abmSelectedIds.add(String(taskId));
    abmLastClickedEl = el;
    abmUpdateSelectionUI();
}

function abmToggleTask(el, taskId) {
    const id = String(taskId);
    if (abmSelectedIds.has(id)) {
        abmSelectedIds.delete(id);
    } else {
        abmSelectedIds.add(id);
        abmLastClickedEl = el;
    }
    abmUpdateSelectionUI();
}

function abmShiftSelectTo(el) {
    const allEls = abmGetAllTaskEls();
    if (!abmLastClickedEl || !allEls.includes(abmLastClickedEl)) {
        abmSelectTask(el, el.dataset.id);
        return;
    }
    const fromIdx = allEls.indexOf(abmLastClickedEl);
    const toIdx = allEls.indexOf(el);
    const start = Math.min(fromIdx, toIdx);
    const end = Math.max(fromIdx, toIdx);
    for (let i = start; i <= end; i++) {
        abmSelectedIds.add(String(allEls[i].dataset.id));
    }
    abmUpdateSelectionUI();
}

function attachABMMultiSelect(div, taskId) {
    // Long-press mobile
    let pressTimer = null;
    div.addEventListener('touchstart', () => {
        pressTimer = setTimeout(() => {
            document.body.classList.add('no-select');
            abmToggleTask(div, taskId);
        }, 600);
    }, { passive: true });
    div.addEventListener('touchend', () => clearTimeout(pressTimer));
    div.addEventListener('touchmove', () => clearTimeout(pressTimer));

    div.addEventListener('click', (e) => {
        if (e.target.closest('.task-checkbox, .dots-btn, .task-options-menu, .edit-box, .custom-dropdown')) return;

        if (e.shiftKey && abmLastClickedEl) {
            e.preventDefault();
            e.stopPropagation();
            document.body.classList.add('no-select');
            abmShiftSelectTo(div);
            return;
        }

        if (e.ctrlKey || e.metaKey) {
            e.preventDefault();
            e.stopPropagation();
            document.body.classList.add('no-select');
            abmToggleTask(div, taskId);
            return;
        }

        // Plain left-click — select single
        if (abmSelectedIds.size > 0) {
            e.stopPropagation();
            if (abmSelectedIds.has(String(taskId))) {
                abmSelectedIds.delete(String(taskId));
                abmUpdateSelectionUI();
            } else {
                abmClearSelection();
                abmSelectTask(div, taskId);
            }
            return;
        }

        e.stopPropagation();
        abmSelectTask(div, taskId);
    });

    div.addEventListener('contextmenu', (e) => {
        e.preventDefault();
    });
}

// Click outside clears selection
document.addEventListener('mousedown', (e) => {
    if (e.button !== 0) return;
    if (!abmCtxMenuOpen) return;
    if (abmCtxMenu && abmCtxMenu.contains(e.target)) return;
    abmHideContextMenu();
});

document.addEventListener('click', (e) => {
    if (e.target.closest('#abm-context-menu')) return;
    if (!e.target.closest('.task-item')) {
        abmClearSelection();
    }
});

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { abmHideContextMenu(); abmClearSelection(); }
});

// Right-click → context menu
document.addEventListener('contextmenu', (e) => {
    if (e.target.closest('#abm-context-menu')) return;
    e.preventDefault();
    if (abmSelectedIds.size === 0) return;
    abmShowContextMenu(e.clientX, e.clientY);
});

function abmShowContextMenu(x, y) {
    if (!abmCtxMenu) abmCtxMenu = document.getElementById('abm-context-menu');
    if (!abmCtxMenu) return;

    const count = abmSelectedIds.size;
    const label = document.getElementById('abm-ctx-selected-label');
    if (label) label.textContent = count + ' task' + (count !== 1 ? 's' : '') + ' selected';

    // Check if ANY selected task is completed
    const hasCompleted = [...abmSelectedIds].some(id => {
        const el = document.getElementById('task-' + id);
        return el && el.dataset.completed === 'true';
    });
    const doneBtn = document.getElementById('abm-ctx-done-btn');
    const undoneBtn = document.getElementById('abm-ctx-undone-btn');
    if (hasCompleted) {
        if (doneBtn) doneBtn.style.display = 'none';
        if (undoneBtn) undoneBtn.style.display = 'flex';
    } else {
        if (doneBtn) doneBtn.style.display = 'flex';
        if (undoneBtn) undoneBtn.style.display = 'none';
    }

    abmCtxMenu.style.display = 'block';
    abmCtxMenuOpen = true;

    const menuW = abmCtxMenu.offsetWidth || 220;
    const menuH = abmCtxMenu.offsetHeight || 350;
    let left = x + 4;
    let top = y + 4;
    if (left + menuW > window.innerWidth) left = x - menuW - 4;
    if (top + menuH > window.innerHeight) top = y - menuH - 4;
    if (top < 4) top = 4;
    if (left < 4) left = 4;
    abmCtxMenu.style.left = left + 'px';
    abmCtxMenu.style.top = top + 'px';
}

function abmHideContextMenu() {
    if (!abmCtxMenu) abmCtxMenu = document.getElementById('abm-context-menu');
    if (abmCtxMenu) abmCtxMenu.style.display = 'none';
    abmCtxMenuOpen = false;
}

function abmGetTargetDate(action) {
    const now = new Date();
    const y = now.getFullYear(), m = now.getMonth(), d = now.getDate();
    let target;
    if (action === 'date-today') target = new Date(y, m, d);
    else if (action === 'date-tomorrow') target = new Date(y, m, d + 1);
    else if (action === 'date-7') target = new Date(y, m, d + 7);
    else if (action === 'date-30') target = new Date(y, m + 1, d);
    else return null;
    const yy = target.getFullYear();
    const mm = String(target.getMonth() + 1).padStart(2, '0');
    const dd = String(target.getDate()).padStart(2, '0');
    return `${yy}-${mm}-${dd}`;
}

async function abmHandleDateAction(action) {
    const ids = [...abmSelectedIds];
    if (!ids.length) return;

    if (action === 'date-custom') {
        abmHideContextMenu();
        const input = document.getElementById('abm-ctx-custom-date-input');
        if (input._flatpickr) input._flatpickr.destroy();
        let picked = false;
        let fpCustom = flatpickr(input, {
            dateFormat: 'Y-m-d',
            appendTo: document.body,
            disableMobile: true,
            onOpen: function(s, d, instance) {
                instance.calendarContainer.classList.add('center-calendar');
            },
            onChange: async function(selectedDates, dateStr) {
                if (!dateStr || picked) return;
                picked = true;
                try { fpCustom.close(); } catch(e) {}
                try { fpCustom.destroy(); } catch(e) {}
                await abmBulkUpdateDate(ids, dateStr);
            },
            onClose: function() {
                setTimeout(() => { try { if (fpCustom) fpCustom.destroy(); } catch(e) {} }, 200);
            }
        });
        fpCustom.open();
        return;
    }

    const due_date = abmGetTargetDate(action);
    if (!due_date) return;
    abmHideContextMenu();
    await abmBulkUpdateDate(ids, due_date);
}

async function abmBulkUpdateDate(ids, due_date) {
    await fetch('/api/bulk-update-date', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids, due_date })
    });
    abmClearSelection();
}

async function abmBulkUpdatePriority(priority) {
    const ids = [...abmSelectedIds];
    if (!ids.length) return;
    abmHideContextMenu();
    await fetch('/api/bulk-update-priority', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids, priority })
    });
    abmClearSelection();
}

async function abmBulkMarkDone() {
    const ids = [...abmSelectedIds];
    if (!ids.length) return;
    abmHideContextMenu();
    await Promise.all(ids.map(id =>
        fetch('/assign_by_me/update-status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, status: 'COMPLETED' })
        })
    ));
    abmClearSelection();
}

async function abmBulkMarkUndone() {
    const ids = [...abmSelectedIds];
    if (!ids.length) return;
    abmHideContextMenu();
    await Promise.all(ids.map(id =>
        fetch('/assign_by_me/update-status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, status: 'OPEN' })
        })
    ));
    abmClearSelection();
}

async function abmBulkDelete() {
    const ids = [...abmSelectedIds];
    if (!ids.length) return;
    document.getElementById('abm-delete-confirm').style.display = 'none';
    await fetch('/api/bulk-delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids })
    });
    abmClearSelection();
}

