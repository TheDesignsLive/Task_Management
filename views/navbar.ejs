<script>
// ── POMODORO TIMER SYSTEM ─────────────────────────────────────────────────────
let _alarmEndTime = null;
let _alarmTickInterval = null;
let _alarmTotalSeconds = 0; // reset ke liye original time store
let _alarmPaused = false;
let _alarmRemaining = 0;
let alarmAudio;
function playAlarmSound() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();

    function tone(freq, start, duration) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      osc.connect(gain);
      gain.connect(ctx.destination);

      // Smooth digital tone
      osc.type = "triangle";   // 🔥 softer than sine
      osc.frequency.value = freq;

      // Soft fade-in / fade-out (gadget feel)
      gain.gain.setValueAtTime(0.0001, ctx.currentTime + start);
      gain.gain.linearRampToValueAtTime(0.25, ctx.currentTime + start + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + start + duration);

      osc.start(ctx.currentTime + start);
      osc.stop(ctx.currentTime + start + duration + 0.05);
    }

    // 🔥 Pattern like cube clock (looping soft pulses)
    let t = 0;
    for (let i = 0; i < 6; i++) {
      tone(900, t, 0.25);
      tone(700, t + 0.25, 0.25);
      t += 0.6;
    }

  } catch (e) {
    console.warn('[Alarm] Audio error:', e);
  }
}

function closeAlarmPanel() { document.getElementById('alarmPanel').style.display = 'none'; }

// 🔥 MM input: Enter → move to SS box
document.getElementById('alarmMM').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') {
    e.preventDefault();
    document.getElementById('alarmSS').focus();
    document.getElementById('alarmSS').select();
  }
});

// 🔥 SS input: Enter → start or resume timer
document.getElementById('alarmSS').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') {
    e.preventDefault();
    if (_alarmPaused) {
      resumeAlarm();
    } else {
      startAlarm();
    }
  }
});

document.getElementById('alarmBtn').addEventListener('click', function(e) {
  e.stopPropagation();

  const panel = document.getElementById('alarmPanel');
  const btn = document.getElementById('alarmBtn');
  const rect = btn.getBoundingClientRect();

  panel.style.top = (rect.bottom + 10) + "px";
  panel.style.left = (rect.left - 200) + "px"; // adjust width

  panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
});
document.addEventListener('click', function(e) {
  const panel = document.getElementById('alarmPanel');
  const btn = document.getElementById('alarmBtn');
  if (!panel.contains(e.target) && !btn.contains(e.target)) panel.style.display = 'none';
});

// Preset — running hone par bhi add karo
function setAlarmPreset(minutes) {
  const addSec = minutes * 60;
  if (_alarmEndTime) {
    // Timer chal raha hai — endTime mein add karo
    _alarmEndTime += addSec * 1000;
    _alarmTotalSeconds += addSec;
    localStorage.setItem('tms_alarm_end', _alarmEndTime);
    localStorage.setItem('tms_alarm_total', _alarmTotalSeconds);

     // Timer nahi chal raha — input box mein add karo
    let curMM = parseInt(document.getElementById('alarmMM').value) || 0;
    let curSS = parseInt(document.getElementById('alarmSS').value) || 0;
    let total = curMM * 60 + curSS + addSec;
    if (total > 99 * 60 + 59) total = 99 * 60 + 59;
    document.getElementById('alarmMM').value = Math.floor(total / 60) || '';
    document.getElementById('alarmSS').value = (total % 60) || '';
  } else {
    // Timer nahi chal raha — input box mein add karo
    let curMM = parseInt(document.getElementById('alarmMM').value) || 0;
    let curSS = parseInt(document.getElementById('alarmSS').value) || 0;
    let total = curMM * 60 + curSS + addSec;
    if (total > 99 * 60 + 59) total = 99 * 60 + 59;
    document.getElementById('alarmMM').value = Math.floor(total / 60) || '';
    document.getElementById('alarmSS').value = (total % 60) || '';
  }
}

function _startTick() {
  if (_alarmTickInterval) clearInterval(_alarmTickInterval);
  _alarmTickInterval = setInterval(() => {
    const remaining = Math.max(0, Math.round((_alarmEndTime - Date.now()) / 1000));
    const rm = Math.floor(remaining / 60);
    const rs = remaining % 60;
    const txt = String(rm).padStart(2,'0') + ':' + String(rs).padStart(2,'0');
    document.getElementById('alarmCountdown').textContent = txt;
    document.getElementById('navAlarmCountdown').textContent = txt;
    if (remaining <= 0) { clearInterval(_alarmTickInterval); triggerAlarm(); }
  }, 500);
}

function startAlarm() {
  const mm = parseInt(document.getElementById('alarmMM').value) || 0;
  const ss = parseInt(document.getElementById('alarmSS').value) || 0;
  const totalSeconds = mm * 60 + ss;
  if (totalSeconds <= 0) { alert('Please enter a valid time.'); return; }

  // 🔥 FIX 2: Clear any stale paused state before starting fresh
  _alarmPaused = false;
  _alarmRemaining = 0;
  localStorage.removeItem('tms_alarm_paused');
  localStorage.removeItem('tms_alarm_remaining');

  _alarmTotalSeconds = totalSeconds;
  _alarmEndTime = Date.now() + totalSeconds * 1000;
  localStorage.setItem('tms_alarm_end', _alarmEndTime);
  localStorage.setItem('tms_alarm_total', _alarmTotalSeconds);

  document.getElementById('alarmCountdown').style.display = 'block';
  document.getElementById('alarmCancelBtn').style.display = 'block';
  document.getElementById('alarmResetBtn').style.display = 'block';
  document.getElementById('alarmResetBtn').innerText = 'Pause';       // 🔥 ensure correct label
  document.getElementById('alarmStartBtn').style.display = 'none';
  document.getElementById('alarmStartBtn').setAttribute('onclick', 'startAlarm()'); // 🔥 reset onclick
  document.getElementById('alarmDot').style.display = 'block';
  document.getElementById('navAlarmCountdown').style.display = 'block';
  _startTick();
}
function resumeAlarm() {
  if (!_alarmPaused || _alarmRemaining <= 0) return;

  _alarmEndTime = Date.now() + _alarmRemaining * 1000;
  _alarmPaused = false;

  localStorage.setItem('tms_alarm_end', _alarmEndTime);
  localStorage.removeItem('tms_alarm_paused');
  localStorage.removeItem('tms_alarm_remaining');

  _startTick();

  document.getElementById('alarmStartBtn').innerText = 'Start';
  document.getElementById('alarmStartBtn').style.display = 'none';
  document.getElementById('alarmResetBtn').style.display = 'block';
  document.getElementById('alarmCancelBtn').style.display = 'block';
}
function resetAlarm() {
  if (!_alarmEndTime) return;

  if (!_alarmPaused) {
    // PAUSE
    _alarmRemaining = Math.max(0, Math.round((_alarmEndTime - Date.now()) / 1000));
    clearInterval(_alarmTickInterval);
    _alarmPaused = true;

    localStorage.setItem('tms_alarm_paused', '1');
    localStorage.setItem('tms_alarm_remaining', _alarmRemaining);

    document.getElementById('alarmStartBtn').style.display = 'block';
    document.getElementById('alarmStartBtn').innerText = 'Resume';
    document.getElementById('alarmStartBtn').setAttribute('onclick', 'resumeAlarm()'); // 🔥
    document.getElementById('alarmResetBtn').style.display = 'none';
    document.getElementById('alarmCancelBtn').style.display = 'block'; // 🔥 keep Reset visible 

  } else {
    // RESUME (inline path — only if not restored from localStorage)
    _alarmEndTime = Date.now() + _alarmRemaining * 1000;
    _alarmPaused = false;

    localStorage.setItem('tms_alarm_end', _alarmEndTime);
    localStorage.removeItem('tms_alarm_paused');
    localStorage.removeItem('tms_alarm_remaining');
    _startTick();

    document.getElementById('alarmStartBtn').innerText = 'Start';
    document.getElementById('alarmStartBtn').setAttribute('onclick', 'startAlarm()'); // 🔥
    document.getElementById('alarmStartBtn').style.display = 'none';
    document.getElementById('alarmResetBtn').style.display = 'block';
    document.getElementById('alarmCancelBtn').style.display = 'block';
  }
}

function triggerAlarm() {
  playAlarmSound();
  localStorage.removeItem('tms_alarm_end');
  localStorage.removeItem('tms_alarm_total');
  document.getElementById('alarmDot').style.display = 'none';
  document.getElementById('alarmCountdown').textContent = '🍅 Time Up!';
  document.getElementById('alarmCountdown').style.color = '#ef4444';
  document.getElementById('navAlarmCountdown').textContent = '00:00';
  document.getElementById('alarmCancelBtn').style.display = 'block';
  document.getElementById('alarmResetBtn').style.display = 'block';
  document.getElementById('alarmStartBtn').style.display = 'none';

  // 🔥 SEND PUSH NOTIFICATION when timer ends
  try {
    const role    = '<%= session.role %>';
    const adminId = '<%= session.adminId || "" %>';
    const userId  = '<%= session.userId  || "" %>';

    let interest = '';
    if (role === 'admin') {
      interest = `admin-user-${adminId}`;
    } else {
      // user or owner
      interest = `user-${userId}`;
    }

    fetch('/send-pomodoro-done', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ interest })
    }).catch(err => console.warn('[Pomodoro] Push notify failed:', err));

  } catch(e) {
    console.warn('[Pomodoro] Push error:', e);
  }

  // 5 sec baad auto reset
  setTimeout(() => {
    cancelAlarm(true);
  }, 5000);
}

function cancelAlarm(silent) {
  if (_alarmTickInterval) { clearInterval(_alarmTickInterval); _alarmTickInterval = null; }
  _alarmEndTime = null;
  _alarmTotalSeconds = 0;
  localStorage.removeItem('tms_alarm_end');
  localStorage.removeItem('tms_alarm_total');
  localStorage.removeItem('tms_alarm_paused');
  localStorage.removeItem('tms_alarm_remaining');
  document.getElementById('alarmDot').style.display = 'none';
  document.getElementById('alarmCountdown').style.display = 'none';
  document.getElementById('alarmCountdown').style.color = '#facc15';
  document.getElementById('alarmCountdown').textContent = '00:00';
  document.getElementById('navAlarmCountdown').textContent = '00:00';
  document.getElementById('alarmStartBtn').innerText = 'Start';
  document.getElementById('alarmStartBtn').setAttribute('onclick', 'startAlarm()'); // 🔥 reset onclick
  document.getElementById('alarmStartBtn').style.display = 'block';
  document.getElementById('alarmResetBtn').style.display = 'none';
  document.getElementById('alarmCancelBtn').style.display = 'none';
  if (!silent) {
    document.getElementById('alarmMM').value = '';
    document.getElementById('alarmSS').value = '';
  }
}

// Page load par restore karo
(function restoreAlarm() {
  // 🔥 Always reset Start button text first
  document.getElementById('alarmStartBtn').innerText = 'Start';

  const saved = localStorage.getItem('tms_alarm_end');
  const savedTotal = localStorage.getItem('tms_alarm_total');
  const wasPaused = localStorage.getItem('tms_alarm_paused') === '1';
  const savedRemaining = parseInt(localStorage.getItem('tms_alarm_remaining')) || 0;

  // 🔥 Restore PAUSED state
if (wasPaused && savedRemaining > 0) {
    _alarmPaused = true;
    _alarmRemaining = savedRemaining;
    _alarmEndTime = Date.now() + savedRemaining * 1000;

    const rm = Math.floor(savedRemaining / 60);
    const rs = savedRemaining % 60;
    const txt = String(rm).padStart(2,'0') + ':' + String(rs).padStart(2,'0');
    document.getElementById('alarmCountdown').textContent = txt;
    document.getElementById('alarmCountdown').style.display = 'block';
    document.getElementById('navAlarmCountdown').textContent = txt;
    document.getElementById('alarmDot').style.display = 'block';

    // 🔥 FIX 1: Fill input boxes with ORIGINAL set time (not paused remaining)
    const savedTotalSeconds = parseInt(localStorage.getItem('tms_alarm_total')) || savedRemaining;
    const tm = Math.floor(savedTotalSeconds / 60);
    const ts = savedTotalSeconds % 60;
    document.getElementById('alarmMM').value = String(tm).padStart(2,'0');
    document.getElementById('alarmSS').value = String(ts).padStart(2,'0');

    document.getElementById('alarmStartBtn').style.display = 'block';
    document.getElementById('alarmStartBtn').innerText = 'Resume';
    document.getElementById('alarmStartBtn').setAttribute('onclick', 'resumeAlarm()');
    document.getElementById('alarmResetBtn').style.display = 'none';
    document.getElementById('alarmCancelBtn').style.display = 'block';
    return;
  }

  if (!saved) return;
  const endTime = parseInt(saved);
  const remaining = Math.round((endTime - Date.now()) / 1000);
  if (remaining <= 0) {
    localStorage.removeItem('tms_alarm_end');
    localStorage.removeItem('tms_alarm_total');
    setTimeout(triggerAlarm, 300);
    return;
  }
  _alarmEndTime = endTime;
  _alarmTotalSeconds = parseInt(savedTotal) || 0;
  document.getElementById('alarmDot').style.display = 'block';
  document.getElementById('alarmCountdown').style.display = 'block';
  document.getElementById('alarmCancelBtn').style.display = 'block';
  document.getElementById('alarmResetBtn').style.display = 'block';
  document.getElementById('alarmStartBtn').style.display = 'none';
  document.getElementById('navAlarmCountdown').style.display = 'block';
  _startTick();
})();
</script>

