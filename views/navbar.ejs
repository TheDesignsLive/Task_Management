  <!-- ── POMODORO NAVBAR COUNTDOWN ── -->
  <div id="navAlarmCountdown" style="
  display:block;
  font-size:32px;
  font-weight:900;
  color:#ffffff;
  letter-spacing:2px;
  white-space:nowrap;
  flex-shrink:0;
  font-variant-numeric:tabular-nums;
  margin:0 10px;
">00:00</div>

  <!-- ── ALARM BUTTON ── -->
  <button type="button" id="alarmBtn" title="Set Alarm" style="
    width:34px; height:34px; min-width:34px;
    border:1px solid rgba(255,255,255,0.4);
    border-radius:50%; background:rgba(255,255,255,0.15);
    display:inline-flex; align-items:center; justify-content:center;
    cursor:pointer; color:#fff; flex-shrink:0; position:relative;
    transition:all 0.2s;
  ">
    <span style="font-size:16px; line-height:1;">🍅</span>
    <span id="alarmDot" style="
      display:none; position:absolute; top:2px; right:2px;
      width:7px; height:7px; border-radius:50%;
      background:#facc15; border:1px solid #fff;
    "></span>
  </button>

  <!-- ── ALARM PANEL ── -->
  <div id="alarmPanel" style="
    display:none; position:fixed;
    top:70px;
right:20px;
    background:#1a3a3a; border:1px solid #0f9d9a;
    border-radius:16px; padding:18px;
    box-shadow:0 12px 40px rgba(0,0,0,0.5);
