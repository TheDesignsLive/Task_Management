async function requestBeamsPermission() {
    // ✅ Make sure SDK is loaded before asking permission
    if (!_beamsClient) {
        try {
            await loadBeamsSDK();
            const PPN = window.PusherPushNotifications;
            if (PPN && PPN.Client) {
                _beamsClient = new PPN.Client({ instanceId: BEAMS_INSTANCE_ID });
            }
        } catch(e) {
            console.warn('[Beams] SDK load failed during permission request');
            return;
        }
    }

    try {
        const permission = await Notification.requestPermission();
        if (permission === 'granted') {
            // ✅ Clear dismissed flag so future sessions work too
            localStorage.removeItem('notif_banner_dismissed');
            await subscribeBeams();
        } else if (permission === 'denied') {
            hideNotifBanner();
            showDeniedGuide();
        }
    } catch(err) {
        console.warn('[Beams] Permission error:', err.message);
    }
}

// ── Called on logout: stop Beams so device unregisters cleanly ──
// Call this before redirecting to /logout if you want clean unsubscribe
async function stopBeams() {
    if (!_beamsClient) return;
    try {
        await _beamsClient.stop();
        console.log('[Beams] ✅ Stopped (logout)');
    } catch(err) {
        console.warn('[Beams] Stop error:', err.message);
    }
}

function showNotifBanner() {
    const banner = document.getElementById('notif-banner');
    if (banner) banner.style.display = 'flex';
}

function hideNotifBanner() {
    const banner = document.getElementById('notif-banner');
    if (banner) banner.style.display = 'none';
}

function dismissNotifBanner() {
    hideNotifBanner();
    // ✅ Remember dismissal across sessions — but NOT forever
    // We use sessionStorage for "this session" dismiss + localStorage for "never show again"
    // Here we do localStorage so the banner doesn't reappear on every page load
    localStorage.setItem('notif_banner_dismissed', '1');
}

function showDeniedGuide() {
    alert(
        'Notifications are blocked by your browser.\n\n' +
        'To enable:\n' +
        '1. Click the 🔒 lock icon in the address bar\n' +
        '2. Find "Notifications" → set to Allow\n' +
        '3. Reload the page\n\n' +
        'After that, notifications will work automatically.'
    );
}

// ✅ Start Beams after page is fully loaded — does not block anything
window.addEventListener('load', initBeams);
// ✅ Only re-subscribe if subscription was lost AND Beams not already active
window.addEventListener('load', async () => {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
    if (_beamsReady) return;
    if (Notification.permission !== 'granted') return;
    try {
        const reg = await navigator.serviceWorker.ready;
        const sub = await reg.pushManager.getSubscription();
        if (!sub) {
            console.log('[Beams] 🔄 Push subscription lost — re-subscribing...');
            setTimeout(async () => {
                if (!_beamsReady) await subscribeBeams();
            }, 2000);
        }
    } catch (e) {
        console.warn('[Beams] Subscription check failed:', e.message);
    }
});
</script>