      <button class="alarm-preset" onclick="setAlarmPreset(10)">10m</button>
      <button class="alarm-preset" onclick="setAlarmPreset(20)">20m</button>
      <button class="alarm-preset" onclick="setAlarmPreset(30)">30m</button>
      <button class="alarm-preset" onclick="setAlarmPreset(60)">1hr</button>
