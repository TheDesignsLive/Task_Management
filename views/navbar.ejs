<script>
const BEAMS_INSTANCE_ID = '423440a8-1fc5-4373-8e6b-0085dccafc58';

const BEAMS_USER_ID = (function() {
    const role    = '<%= session.role %>';
    const adminId = '<%= session.adminId || "" %>';
    const userId  = '<%= session.userId  || "" %>';
    if (role === 'admin' || role === 'owner') return 'admin_' + adminId;
    return String(userId);
})();

let _beamsClient = null;
let _beamsReady  = false;

function loadBeamsSDK() {
    return new Promise((resolve, reject) => {
        if (window.PusherPushNotifications) return resolve();
        const s = document.createElement('script');
        s.src   = 'https://js.pusher.com/beams/1.0/push-notifications-cdn.js';
        s.async = true;
        s.onload  = resolve;
        s.onerror = () => reject(new Error('Beams SDK failed to load'));
        document.head.appendChild(s);
    });
}

async function initBeams() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
        console.warn('[Beams] Push not supported in this browser');
        return;
    }

    try {
        const swReg = await navigator.serviceWorker.register('/service-worker.js', { scope: '/' });
        console.log('[Beams] ✅ SW registered, scope:', swReg.scope);

        await loadBeamsSDK();

        const PPN = window.PusherPushNotifications;
        if (!PPN || !PPN.Client) {
            console.warn('[Beams] SDK not available after load');
            return;
        }

        _beamsClient = new PPN.Client({ instanceId: BEAMS_INSTANCE_ID });

        const permission = Notification.permission;

        if (permission === 'granted') {
            // ✅ Already allowed — subscribe silently, no banner
            await subscribeBeams();

        } else if (permission === 'default') {
            // ✅ Never asked — show banner OR auto-ask if first login
            const alreadySubscribed = localStorage.getItem('beams_subscribed_' + BEAMS_USER_ID);
            const dismissed = localStorage.getItem('notif_banner_dismissed');

            if (!alreadySubscribed && !dismissed) {
                // ✅ First time for this user — auto trigger permission popup
                // Small delay so page finishes loading first
                setTimeout(async () => {
                    await requestBeamsPermission();
                }, 1500);
            } else if (!dismissed) {
                showNotifBanner();
            }
        }
        // 'denied' → do nothing, user goes to Settings to fix

    } catch (err) {
        console.warn('[Beams] Init error:', err.message);
    }
}
// ✅ SAVE CURRENT USER ID FOR SERVICE WORKER
async function storeMyIdForSW() {
    try {
        const userId = BEAMS_USER_ID; // already calculated

        const cache = await caches.open('tms-user-data');

        await cache.put(
            '/my-id',
            new Response(userId)
        );

        console.log('[SW] ✅ My ID stored:', userId);

    } catch (err) {
        console.error('[SW] ❌ Failed to store ID:', err);
    }
}

// ✅ call after page load
window.addEventListener('load', storeMyIdForSW);

async function subscribeBeams() {
    if (_beamsReady) return;
    if (!_beamsClient) return;

    try {
        await _beamsClient.start();

        const tokenProvider = new window.PusherPushNotifications.TokenProvider({
            url: '/beams-auth',
            credentials: 'include',
        });

        try {
    const currentId = await _beamsClient.getUserId();

    if (currentId && currentId !== BEAMS_USER_ID) {
        console.log('[Beams] 🔄 Different user detected, stopping old session...');
        await _beamsClient.stop();   // 🔥 IMPORTANT FIX
        await _beamsClient.start();  // restart clean
    }

} catch (e) {
    console.log('[Beams] No previous user, fresh start');
}

await _beamsClient.setUserId(BEAMS_USER_ID, tokenProvider);
        // ================== ADD THIS BLOCK ==================
const role    = '<%= session.role %>';
const adminId = '<%= session.adminId || "" %>';
const userId  = '<%= session.userId  || "" %>';
const teamId  = '<%= session.team_id || "" %>';

if (role === 'admin') {
    await _beamsClient.addDeviceInterest(`admin-${adminId}`);
    await _beamsClient.addDeviceInterest(`admin-user-${adminId}`);
}

else if (role === 'owner') {
    await _beamsClient.addDeviceInterest(`admin-${adminId}`);
    await _beamsClient.addDeviceInterest(`user-${userId}`);

    if (teamId) {
        await _beamsClient.addDeviceInterest(`company-${adminId}-team-${teamId}`);
    }
}

else {
    await _beamsClient.addDeviceInterest(`company-${adminId}-all`);
    await _beamsClient.addDeviceInterest(`user-${userId}`);

    if (teamId) {
        await _beamsClient.addDeviceInterest(`company-${adminId}-team-${teamId}`);
    }
}
// ====================================================

        // ✅ Remember this user subscribed — survives logout/login
        localStorage.setItem('beams_subscribed_' + BEAMS_USER_ID, '1');


      // ADD these two lines:
      localStorage.setItem('desktop_beams_' + BEAMS_USER_ID, '1');
      localStorage.setItem('desktop_beams_last_user', BEAMS_USER_ID);

        localStorage.removeItem('notif_banner_dismissed');

        _beamsReady = true;
        console.log('[Beams] ✅ Subscribed as:', BEAMS_USER_ID);
        hideNotifBanner();

    } catch (err) {
        console.warn('[Beams] Subscribe error:', err.message);
    }
}

async function requestBeamsPermission() {
    // ✅ Make sure SDK is loaded before asking permission
    if (!_beamsClient) {
        try {
            await loadBeamsSDK();
            const PPN = window.PusherPushNotifications;
            if (PPN && PPN.Client) {
                _beamsClient = new PPN.Client({ instanceId: BEAMS_INSTANCE_ID });
            }
        } catch(e) {
            console.warn('[Beams] SDK load failed during permission request');
            return;
        }
    }

    try {
        const permission = await Notification.requestPermission();
        if (permission === 'granted') {
            // ✅ Clear dismissed flag so future sessions work too
            localStorage.removeItem('notif_banner_dismissed');
            await subscribeBeams();
        } else if (permission === 'denied') {
            hideNotifBanner();
            showDeniedGuide();
        }
    } catch(err) {
        console.warn('[Beams] Permission error:', err.message);
    }
}

// ── Called on logout: stop Beams so device unregisters cleanly ──
// Call this before redirecting to /logout if you want clean unsubscribe
async function stopBeams() {
    if (!_beamsClient) return;
    try {
        await _beamsClient.stop();
        console.log('[Beams] ✅ Stopped (logout)');
    } catch(err) {
        console.warn('[Beams] Stop error:', err.message);
    }
}

function showNotifBanner() {
    const banner = document.getElementById('notif-banner');
    if (banner) banner.style.display = 'flex';
}

function hideNotifBanner() {
    const banner = document.getElementById('notif-banner');
    if (banner) banner.style.display = 'none';
}

function dismissNotifBanner() {
    hideNotifBanner();
    // ✅ Remember dismissal across sessions — but NOT forever
    // We use sessionStorage for "this session" dismiss + localStorage for "never show again"
    // Here we do localStorage so the banner doesn't reappear on every page load
    localStorage.setItem('notif_banner_dismissed', '1');
}

function showDeniedGuide() {
    alert(
        'Notifications are blocked by your browser.\n\n' +
        'To enable:\n' +
        '1. Click the 🔒 lock icon in the address bar\n' +
        '2. Find "Notifications" → set to Allow\n' +
        '3. Reload the page\n\n' +
        'After that, notifications will work automatically.'
    );
}

// ✅ Start Beams after page is fully loaded — does not block anything
window.addEventListener('load', initBeams);
// ✅ Only re-subscribe if subscription was lost AND Beams not already active
window.addEventListener('load', async () => {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
    if (_beamsReady) return;
    if (Notification.permission !== 'granted') return;
    try {
        const reg = await navigator.serviceWorker.ready;
        const sub = await reg.pushManager.getSubscription();
        if (!sub) {
            console.log('[Beams] 🔄 Push subscription lost — re-subscribing...');
            setTimeout(async () => {
                if (!_beamsReady) await subscribeBeams();
            }, 2000);
        }
    } catch (e) {
        console.warn('[Beams] Subscription check failed:', e.message);
    }
});
</script>