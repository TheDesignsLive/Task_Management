          font-weight:700; outline:none;
        "/>
        <span style="font-size:9px; color:#aaa;">MM</span>
      </div>
      <span style="font-size:18px; color:#0f9d9a; font-weight:700; margin-bottom:12px;">:</span>
      <div style="display:flex; flex-direction:column; align-items:center; gap:3px;">
        <input id="alarmSS" type="number" min="0" max="59" placeholder="00" maxlength="2" oninput="this.value=this.value.slice(0,2)" style="
          width:62px; text-align:center; padding:6px 4px;
          background:#2a4a4a; border:1px solid #0f9d9a;
          border-radius:8px; color:#fff; font-size:15px;
          font-weight:700; outline:none;
        "/>
        <span style="font-size:9px; color:#aaa;">SS</span>
      </div>
    </div>

    <!-- Countdown display -->
    <div id="alarmCountdown" style="
      text-align:center; font-size:22px; font-weight:800;
      color:#facc15; letter-spacing:2px; margin-bottom:12px;
      display:none; font-variant-numeric:tabular-nums;
    ">00:00:00</div>

    <!-- Buttons -->
    <div style="display:flex; gap:8px;">
      <button id="alarmStartBtn" onclick="startAlarm()" style="
        flex:1; padding:9px; background:#0f9d9a;
        border:none; border-radius:10px; color:#fff;
        font-size:13px; font-weight:700; cursor:pointer;
      ">Start</button>
      <button id="alarmResetBtn" onclick="resetAlarm()" style="
        flex:1; padding:9px; background:rgba(250,204,21,0.15);
        border:1px solid rgba(250,204,21,0.4); border-radius:10px;
        color:#facc15; font-size:13px; font-weight:700;
        cursor:pointer; display:none;
      ">Pause</button>
      <button id="alarmCancelBtn" onclick="cancelAlarm()" style="
        flex:1; padding:9px; background:rgba(239,68,68,0.15);
        border:1px solid rgba(239,68,68,0.4); border-radius:10px;
        color:#ef4444; font-size:13px; font-weight:700;
        cursor:pointer; display:none;
      ">Reset</button>
    </div>
  </div>

  <div class="user-display" id="navWelcomeText">
    Welcome <%= (typeof session !== "undefined" && (session.userName || session.adminName)) ? (session.userName || session.adminName) : "Guest" %>
  </div>
</div>

