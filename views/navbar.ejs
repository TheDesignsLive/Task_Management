<script>
const textarea = document.getElementById("taskInput");
const dateInput = document.getElementById("datePicker");
const dateDisplay = document.getElementById("dateDisplay");
const flagDropdown = document.getElementById("flag");


function formatDate(date){
  const d = new Date(date);
  const day = d.getDate().toString().padStart(2,"0");
  const month = d.toLocaleString("en-US",{month:"short"});
  return day + " " + month;
}


const dropdown = document.getElementById("assignDropdown");
const selected = document.getElementById("selectedValue");
const menu = document.getElementById("dropdownMenu");

window.assignedTo = "self";

  //Notify user
    window.notifyUser = false;

  const notifyBtn = document.getElementById("notifyBtn");

  notifyBtn.addEventListener("click", () => {
    window.notifyUser = !window.notifyUser;

    notifyBtn.classList.toggle("active", window.notifyUser);

notifyBtn.innerHTML = window.notifyUser
  ? '<i class="fa-solid fa-bell"></i><span class="notify-text">ON</span>'
  : '<i class="fa-regular fa-bell"></i><span class="notify-text">OFF</span>';
});
  //over

// ✅ Toggle dropdown
selected.addEventListener("click", () => {
  menu.style.display = menu.style.display === "block" ? "none" : "block";
});

