<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<title>Settings</title>
<link rel="icon" type="image/svg" href="/images/tms.svg">
<style>
/* Background and layout */
body{margin:0;font-family:Arial, sans-serif;background:#3C3A3A;color: #fff;}
.layout{display:flex;min-height:calc(100vh - 60px);}
.sidebar-container{width:55px;}
.main-content{flex:1;padding:20px;background:#3C3A3A;}

/* Settings Menu - Dark Theme Style */
.settings-menu{background:rgba(255, 255, 255, 0.05);border-radius:8px;overflow:hidden;margin-bottom:20px;border: 1px solid rgba(255, 255, 255, 0.1);}
.settings-item{padding:15px;border-bottom:1px solid rgba(255, 255, 255, 0.1);cursor:pointer;color: #eee;}
.settings-item:hover{background:rgba(255, 255, 255, 0.1);}
.settings-item.danger { color: #ff6b6b; font-weight: bold; }
.settings-item.danger:hover { background: rgba(217, 83, 79, 0.1); }

/* Input group for Password Eye Icon */
.input-group { position: relative; margin: 6px 0; text-align: left; }
.input-group label { display: block; font-size: 13px; margin-bottom: 4px; color: #555; font-weight: bold; }
input{width:100%;padding:10px;padding-right:40px;box-sizing:border-box;border-radius:6px;border:1px solid #ccc; margin-bottom: 10px;}
.input-group i { position: absolute; right: 12px; top: 32px; cursor: pointer; color: #999; }

button{width:100%;padding:10px;background:#095959;color:#fff;border:none;cursor:pointer;margin-top:15px;border-radius:6px;font-weight:bold;}
button:hover{background:#0b7373;}
#alarmBtn{width:34px;margin-top:0;padding:0;background:rgba(255,255,255,0.15);border-radius:50%;font-weight:normal;}
#alarmBtn:hover{background:rgba(255,255,255,0.25);}

/* === DIALOG MODAL STYLES === */
.modal, .dialog-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.65); backdrop-filter: blur(4px);
    display: none; justify-content: center; align-items: center; z-index: 999;
}
.modal-content, .dialog-box {
    background: #fff; width: 380px; padding: 25px; border-radius: 12px;
    position: relative; text-align: center; box-shadow: 0 15px 40px rgba(0,0,0,0.25);
    color: #333;
}
.close-btn {
    position: absolute; top: 12px; right: 15px; cursor: pointer; font-size: 18px; font-weight: bold; color: #555;
}
.close-btn:hover { color: red; }

.modal-buttons { 
    margin-top: 25px; 
    display: flex; 
    justify-content: center; 
    gap: 15px; 
}
.btn { 
    flex: 1; 
    height: 44px; 
    border: none; 
    cursor: pointer; 
    border-radius: 8px; 
    font-size: 15px; 
    font-weight: bold; 
    display: flex; 
    align-items: center; 
    justify-content: center;
    text-decoration: none;
    padding: 0; 
    margin: 0;
    transition: 0.2s;
    box-sizing: border-box;
}
.btn-success { background-color: #0F8989; color: #fff; } 
.btn-success:hover { background-color: #0c7575; }
.btn-danger { background-color: #d9534f; color: #fff; }
.btn-danger:hover { background-color: #c9302c; }
.btn-cancel { background-color: #f1f1f1; color: #333; }
.btn-cancel:hover { background-color: #e2e2e2; }

#pwdError, #matchError { color: #d9534f; font-size: 11px; margin-top: 4px; display: none; text-align: left; line-height: 1.4; }
.export-pick-btn {
  display: block; position: relative; background: #f5f5f5;
  border: 1px solid #d6e3df; border-radius: 8px;
  padding: 12px 16px; margin-bottom: 10px; cursor: pointer;
  font-size: 14px; font-weight: 600; color: #333;
  width: 100%; box-sizing: border-box; text-align: left;
}
.export-pick-btn:hover { background: #e8f5f5; }
.exp-card { border-left: 3px solid #ccc; background: #f9f9f9; border-radius: 6px; padding: 8px 12px; margin-bottom: 8px; }
.dropdown-selected {
  background: #fff;
  border: 1px solid #d6e3df;
  border-radius: 20px;
  padding: 6px 12px;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #222; /* ✅ ADD THIS */
}
</style>
</head>

<body>

<%- include('navbar') %>

<div class="layout">
  <div class="sidebar-container">
    <%- include('sidebar') %>
  </div>

  <div class="main-content">
    <h2 style="margin-top: 0;">Settings</h2>
    <div class="settings-menu">
        <div class="settings-item" onclick="openPasswordDialog()">Change Password</div>
        <div class="settings-item" onclick="openEmailDialog()">Change Gmail</div>
<% if (session.role === 'admin' || session.role === 'owner') { %>
<div class="settings-item" onclick="openLabelsDialog()">Section Labels <span style="font-size:11px;color:#aaa;margin-left:6px;">(<%= label_changes %> & <%= label_update %>)</span></div>
<% } %>
      <div class="settings-item" onclick="openNotifDialog()" id="notifSettingItem">
  Notifications 
  <span id="notifStatusBadge" style="font-size:11px;margin-left:6px;padding:2px 8px;border-radius:10px;background:#e6f7f5;color:#0f9d9a;">checking...</span>
</div>
<div class="settings-item" onclick="openExportDialog()">
  Export Tasks
  <span style="font-size:11px;color:#aaa;margin-left:6px;">Download as Excel or CSV</span>
</div>
<div class="settings-item danger" onclick="openDeleteDialog()">Delete Profile</div>
        <div class="settings-item danger" onclick="openLogoutModal()">Logout</div>
    </div>
  </div>
</div>

<div id="passwordDialog" class="dialog-overlay">
    <div class="dialog-box">
        <span class="close-btn" onclick="closePasswordDialog()">✖</span>
        <h3 style="margin-top:0;">Change Password</h3>
        
        <div id="pwd-step1">
            <p style="font-size: 14px; color: #555;">To change password, verify your email:<br><strong><%= session.email %></strong></p>
            <button type="button" onclick="sendOtpForPassword()">Send Verification OTP</button>
        </div>

        <div id="pwd-step2" style="display:none;">
            <p style="color:green; font-size:14px;">OTP sent to your email.</p>
            <input type="text" id="pwdOtpInput" placeholder="Enter OTP">
            <button type="button" onclick="verifyPwdOtp()">Verify OTP</button>
        </div>

        <form id="changePasswordForm" style="display:none;">
            <div class="input-group">
                <label>New Password</label>
                <input type="password" name="new_password" id="newPwd" placeholder="Enter new password" required>
                <i class="fa-solid fa-eye-slash" onclick="togglePwd('newPwd', this)"></i>
                <div id="pwdError">Must be 8+ characters with 1 uppercase, 1 lowercase & 1 number.</div>
            </div>
            <div class="input-group">
                <label>Confirm Password</label>
                <input type="password" name="confirm_password" id="confPwd" placeholder="Confirm new password" required>
                <i class="fa-solid fa-eye-slash" onclick="togglePwd('confPwd', this)"></i>
                <div id="matchError">Passwords do not match. Please try again.</div>
            </div>
            <button type="submit">Update Password</button>
        </form>
    </div>
</div>

<div id="emailDialog" class="dialog-overlay">
    <div class="dialog-box">
        <span class="close-btn" onclick="closeEmailDialog()">✖</span>
        <h3 style="margin-top:0;">Change Gmail</h3>
        <div id="email-step1">
            <p style="font-size: 14px; color: #555;">Current Email: <strong id="currentEmailDisplay"><%= session.email %></strong></p>
            <button type="button" onclick="sendOtpToCurrent('<%= session.email %>')">Send OTP to Current Email</button>
        </div>
        <div id="email-step2" style="display:none;">
            <p style="color:green; font-size:14px;">OTP sent to current email.</p>
            <input type="text" id="currentOtpInput" placeholder="Enter OTP">
            <button type="button" onclick="verifyCurrentOtp()">Confirm OTP</button>
        </div>
        <div id="email-step3" style="display:none;">
            <p style="font-size: 14px; color: #555;">Current email verified.</p>
            <input type="email" id="newEmailInput" placeholder="Enter New Email Address" required>
            <button type="button" onclick="sendOtpToNew()">Send OTP to New Email</button>
        </div>
        <div id="email-step4" style="display:none;">
            <p style="color:green; font-size:14px;">OTP sent to new email.</p>
            <form id="changeEmailForm" onsubmit="return verifyNewOtpAndSubmit(event)">
                <input type="hidden" name="new_email" id="finalNewEmail">
                <input type="text" id="newOtpInput" placeholder="Enter OTP" required>
                <button type="submit">Confirm & Change Gmail</button>
            </form>
        </div>
    </div>
</div>

<div id="labelsDialog" class="dialog-overlay">
  <div class="dialog-box">
    <span class="close-btn" onclick="closeLabelsDialog()">✖</span>
    <h3 style="margin-top:0;">Section Labels</h3>
    <p style="font-size:13px;color:#555;">Customize display names for the Change and Update sections.</p>
    <div class="input-group">
      <label>Change Section Name</label>
      <input type="text" id="labelChanges" value="<%= label_changes %>" placeholder="e.g. Change">
    </div>
    <div class="input-group">
      <label>Update Section Name</label>
      <input type="text" id="labelUpdate" value="<%= label_update %>" placeholder="e.g. Update">
    </div>
    <button type="button" onclick="saveLabels()">Save Labels</button>
  </div>
</div>

<div id="logoutModal" class="modal">
  <div class="modal-content">
    <h2 style="margin-top:0;">Confirm Logout</h2>
    <p style="color:#555;">Logout from <br><strong style="color:#095959;"><%= session.email %></strong> ?</p>
    <div class="modal-buttons">
      <button type="button" onclick="handleLogout()" class="btn btn-danger">Logout</button>
      <button type="button" onclick="closeLogoutModal()" class="btn btn-cancel">Cancel</button>
    </div>
  </div>
</div>

<div id="adminDeleteModal" class="modal">
  <div class="modal-content">
    <h2 style="margin-top:0; color:#d9534f;">Delete Profile</h2>
    <div id="del-step1">
        <p style="color:#555;">Are you sure? All associated employee data will be permanently lost. Verification required.</p>
        <button type="button" onclick="sendOtpForDelete()" class="btn btn-danger" style="margin-top:10px;">Send OTP to <%= session.email %></button>
    </div>
    <div id="del-step2" style="display:none;">
        <p style="color:green; font-size:14px;">OTP sent. Please verify to delete.</p>
        <input type="text" id="delOtpInput" placeholder="Enter OTP" style="margin-top:10px;">
        <button type="button" onclick="verifyDeleteOtp()" class="btn btn-danger">Confirm Deletion</button>
    </div>
    <div class="modal-buttons">
      <button type="button" onclick="closeDeleteDialogs()" class="btn btn-cancel">Cancel</button>
    </div>
  </div>
</div>

<div id="userCannotDeleteModal" class="modal">
  <div class="modal-content">
    <h3 style="margin-top:0; color:#d9534f;">Action Denied</h3>
    <p style="color:#333;">Please contact your admin to remove your profile.</p>
    <div class="modal-buttons">
      <button type="button" onclick="closeDeleteDialogs()" class="btn btn-cancel">Okay</button>
    </div>
  </div>
</div>
<div id="notifDialog" class="dialog-overlay">
  <div class="dialog-box">
    <span class="close-btn" onclick="closeNotifDialog()">✖</span>
    <h3 style="margin-top:0;">🔔 Notifications</h3>
    <p style="font-size:14px;color:#555;line-height:1.7;text-align:left;" id="notifDialogMsg">Checking...</p>
    <button type="button" id="notifDialogBtn" onclick="handleNotifAction()"
      style="background:#0f9d9a;color:#fff;border:none;padding:10px;border-radius:6px;
             cursor:pointer;width:100%;font-weight:bold;margin-top:10px;font-size:14px;">
      Enable Notifications
    </button>
  </div>
</div>
<!-- ── EXPORT TASKS DIALOG ── -->
<div id="exportDialog" class="dialog-overlay">
  <div class="dialog-box" style="max-width:420px;max-height:80vh;overflow-y:auto;text-align:left;">
    <span class="close-btn" onclick="closeExportDialog()">✖</span>
    <h3 style="margin-top:0;text-align:center;">📤 Export Tasks</h3>

    <!-- Step 1: Section -->
    <div id="export-step1">
      <p style="font-size:13px;color:#555;text-align:center;">Which section do you want to export?</p>
      <div id="exportSectionBtns"></div>
    </div>

    <!-- Step 2: Date -->
    <div id="export-step2" style="display:none;">
      <p style="font-size:13px;color:#555;text-align:center;">Filter by date or export all?</p>
      <button type="button" class="export-pick-btn" onclick="loadExportPreview('')">📋 All Tasks</button>
      <button type="button" id="exportDateBtn" class="export-pick-btn">
        📅 <span id="exportDateLabel">Pick a Date</span>
      </button>
      <input type="text" id="exportDateInput" style="display:none;">
      <button type="button" onclick="exportStep(1)"
        style="background:#f5f5f5;color:#555;border:none;padding:8px;border-radius:6px;cursor:pointer;width:100%;margin-top:4px;">
        ← Back
      </button>
    </div>

    <!-- Step 3: Preview + Download -->
    <div id="export-step3" style="display:none;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <span id="exportCount" style="font-size:12px;color:#888;">0 tasks</span>
        <button type="button" onclick="exportStep(2)"
          style="background:none;border:none;color:#095959;font-size:12px;cursor:pointer;font-weight:bold;">← Back</button>
      </div>
      <div id="exportLoading" style="text-align:center;padding:20px;color:#888;display:none;">Loading…</div>
      <div id="exportPreviewList" style="max-height:35vh;overflow-y:auto;margin-bottom:12px;"></div>
      <button type="button" id="exportExcelBtn" onclick="doExportExcel()"
        style="background:#095959;color:#fff;border:none;padding:10px;border-radius:6px;cursor:pointer;width:100%;font-weight:bold;margin-bottom:8px;">
        ⬇ Export Excel
      </button>
      <button type="button" id="exportCsvBtn" onclick="doExportCsv()"
        style="background:#fff;color:#095959;border:1px solid #095959;padding:10px;border-radius:6px;cursor:pointer;width:100%;font-weight:bold;">
        ⬇ Export CSV
      </button>
      </button>

<!-- ✅ EXPORT GUIDE (ADD THIS) -->
<div style="margin-top:10px;font-size:12px;color:#666;line-height:1.6;">
  <strong>Guide:</strong><br>
  • <b>Excel Export</b> → Styled format with colors based on priority<br>
  &nbsp;&nbsp;&nbsp;🔴 High = Red &nbsp;&nbsp;🟡 Medium = Yellow &nbsp;&nbsp;🔵 Low = Blue<br>
  • <b>CSV Export</b> → Simple plain file (no colors, lightweight)
</div>
    </div>
  </div>
</div>
<div class="dialog-overlay" id="customAlertModal">
  <div class="modal-content" style="text-align: center;">
    <i id="customAlertIcon" class="fa-solid fa-circle-check" style="font-size: 40px; margin-bottom: 10px;"></i>
    <h3 id="customAlertTitle" style="margin-top:0;">Message</h3>
    <p id="customAlertMessage" style="color: #555; font-size: 15px; margin-bottom: 25px;"></p>
    <div class="modal-buttons" style="margin-top: 0;">
        <button id="customAlertBtn" class="btn btn-success" style="width: 100%;">Okay</button>
    </div>
  </div>
</div>

<script>
let alertRedirectUrl = null;
let generatedPwdOtp = "";
let generatedDelOtp = "";

function showAlertDialog(title, message, isSuccess, redirectUrl = null) {
  document.getElementById("customAlertTitle").innerText = title;
  document.getElementById("customAlertMessage").innerText = message;
  const icon = document.getElementById("customAlertIcon");
  const btn = document.getElementById("customAlertBtn");
  if(isSuccess) {
      icon.className = "fa-solid fa-circle-check";
      icon.style.color = "#2ecc71";
      btn.className = "btn btn-success";
  } else {
      icon.className = "fa-solid fa-triangle-exclamation";
      icon.style.color = "#e74c3c";
      btn.className = "btn btn-danger";
  }
  alertRedirectUrl = redirectUrl;
  document.getElementById("customAlertModal").style.display = "flex";
}

document.getElementById("customAlertBtn").addEventListener("click", function() {
  document.getElementById("customAlertModal").style.display = "none";
  if(alertRedirectUrl) window.location.href = alertRedirectUrl;
});

function openPasswordDialog() { 
    document.getElementById('passwordDialog').style.display = 'flex'; 
    document.getElementById('pwd-step1').style.display = 'block';
    document.getElementById('pwd-step2').style.display = 'none';
    document.getElementById('changePasswordForm').style.display = 'none';
}
function closePasswordDialog() { document.getElementById('passwordDialog').style.display = 'none'; }

function openEmailDialog() {
    document.getElementById('emailDialog').style.display = 'flex';
    document.getElementById('email-step1').style.display = 'block';
    ['email-step2','email-step3','email-step4'].forEach(s => document.getElementById(s).style.display='none');
}
function closeEmailDialog() { document.getElementById('emailDialog').style.display = 'none'; }

function openLogoutModal() { document.getElementById('logoutModal').style.display = 'flex'; }
function closeLogoutModal() { document.getElementById('logoutModal').style.display = 'none'; }

function openDeleteDialog() {
    const userRole = "<%= session.role %>";
    if (userRole === "admin") {
        document.getElementById('adminDeleteModal').style.display = 'flex';
        document.getElementById('del-step1').style.display = 'block';
        document.getElementById('del-step2').style.display = 'none';
    }
    else document.getElementById('userCannotDeleteModal').style.display = 'flex';
}
async function handleLogout() {
  try {
    // ===== 1. STOP BEAMS =====
    if (typeof beamsClient !== "undefined") {
      await beamsClient.clearAllState();
      await beamsClient.stop();
    }

    // ===== 2. UNSUBSCRIBE PUSH =====
    if ('serviceWorker' in navigator) {
      const reg = await navigator.serviceWorker.getRegistration();
      if (reg) {
        const sub = await reg.pushManager.getSubscription();
        if (sub) {
          await sub.unsubscribe();  // 🔥 VERY IMPORTANT
        }
      }
    }

    // ===== 3. UNREGISTER SERVICE WORKER =====
    const registrations = await navigator.serviceWorker.getRegistrations();
    for (let registration of registrations) {
      await registration.unregister(); // 🔥 THIS STOPS BACKGROUND PUSH
    }

  } catch (err) {
    console.error("Logout cleanup error:", err);
  }

  // ===== 4. REDIRECT =====
  window.location.href = "/logout";
}
function closeDeleteDialogs() { 
    document.getElementById('adminDeleteModal').style.display = 'none'; 
    document.getElementById('userCannotDeleteModal').style.display = 'none'; 
}
function openLabelsDialog() { document.getElementById('labelsDialog').style.display = 'flex'; }
function closeLabelsDialog() { document.getElementById('labelsDialog').style.display = 'none'; }

async function saveLabels() {
    const label_changes = document.getElementById('labelChanges').value.trim();
    const label_update = document.getElementById('labelUpdate').value.trim();
    if (!label_changes || !label_update) {
        showAlertDialog("Error", "Both label names are required.", false);
        return;
    }
    try {
        const res = await fetch('/settings/update-labels', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ label_changes, label_update })
        });
        const data = await res.json();
        if (data.success) {
            closeLabelsDialog();
            showAlertDialog("Success!", data.message, true);
        } else {
            showAlertDialog("Error", data.message, false);
        }
    } catch(err) {
        showAlertDialog("Error", "Server connection failed.", false);
    }
}
function togglePwd(id, icon) {
    const input = document.getElementById(id);
    if (input.type === "password") {
        input.type = "text";
        icon.classList.replace("fa-eye-slash", "fa-eye");
    } else {
        input.type = "password";
        icon.classList.replace("fa-eye", "fa-eye-slash");
    }
}

function generateOtp() { return Math.floor(100000 + Math.random() * 900000).toString(); }

// PASSWORD OTP LOGIC
async function sendOtpForPassword() {
    generatedPwdOtp = generateOtp();
    document.getElementById('pwd-step1').style.display = 'none';
    document.getElementById('pwd-step2').style.display = 'block';
    try {
        await fetch('/forgot-password/send-otp', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contact: '<%= session.email %>', otp: generatedPwdOtp, sent_for: 'change_password' })
        });
    } catch(err) { console.error(err); }
}

function verifyPwdOtp() {
    if (document.getElementById('pwdOtpInput').value === generatedPwdOtp) {
        document.getElementById('pwd-step2').style.display = 'none';
        document.getElementById('changePasswordForm').style.display = 'block';
    } else {
        showAlertDialog("Invalid OTP", "The code you entered is incorrect.", false);
    }
}

// DELETE PROFILE OTP LOGIC
async function sendOtpForDelete() {
    generatedDelOtp = generateOtp();
    document.getElementById('del-step1').style.display = 'none';
    document.getElementById('del-step2').style.display = 'block';
    try {
        await fetch('/forgot-password/send-otp', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contact: '<%= session.email %>', otp: generatedDelOtp, sent_for: 'delete_profile' })
        });
    } catch(err) { console.error(err); }
}

function verifyDeleteOtp() {
    if (document.getElementById('delOtpInput').value === generatedDelOtp) {
        confirmDeleteProfile();
    } else {
        showAlertDialog("Invalid OTP", "The code you entered is incorrect.", false);
    }
}

document.getElementById('changePasswordForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const newPwd = document.getElementById('newPwd').value;
    const confPwd = document.getElementById('confPwd').value;
    const pwdRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/;
    
    if (!pwdRegex.test(newPwd)) {
        document.getElementById('pwdError').style.display = 'block';
        return;
    }
    if (newPwd !== confPwd) {
        document.getElementById('matchError').style.display = 'block';
        return;
    }

    try {
        const res = await fetch('/settings/change-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ new_password: newPwd })
        });
        const data = await res.json();
        if(data.success) {
            closePasswordDialog();
            showAlertDialog("Success!", data.message, true);
            this.reset();
        } else {
            showAlertDialog("Error", data.message, false);
        }
    } catch(err) {
        showAlertDialog("Error", "Server connection failed.", false);
    }
});

// EMAIL OTP LOGIC
let generatedCurrentOtp = "";
let generatedNewOtp = "";

async function sendOtpToCurrent(email) {
    generatedCurrentOtp = generateOtp();
    document.getElementById('email-step1').style.display = 'none';
    document.getElementById('email-step2').style.display = 'block';
    try {
        await fetch('/forgot-password/send-otp', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contact: email, otp: generatedCurrentOtp, sent_for: 'change_email' })
        });
    } catch(err) { console.error(err); }
}

function verifyCurrentOtp() {
    if (document.getElementById('currentOtpInput').value === generatedCurrentOtp) {
        document.getElementById('email-step2').style.display = 'none';
        document.getElementById('email-step3').style.display = 'block';
    } else {
        showAlertDialog("Invalid OTP", "The code you entered is incorrect.", false);
    }
}

async function sendOtpToNew() {
    const newEmail = document.getElementById('newEmailInput').value;
    if(!newEmail) {
        showAlertDialog("Error", "Please enter a valid email.", false);
        return;
    }
    generatedNewOtp = generateOtp();
    document.getElementById('finalNewEmail').value = newEmail;
    document.getElementById('email-step3').style.display = 'none';
    document.getElementById('email-step4').style.display = 'block';
    try {
        await fetch('/forgot-password/send-otp', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contact: newEmail, otp: generatedNewOtp, sent_for: 'change_email' })
        });
    } catch(err) { console.error(err); }
}

async function verifyNewOtpAndSubmit(e) {
    e.preventDefault();
    if (document.getElementById('newOtpInput').value !== generatedNewOtp) {
        showAlertDialog("Invalid OTP", "The code you entered is incorrect.", false);
        return false;
    }
    const newEmail = document.getElementById('finalNewEmail').value;
    try {
        const res = await fetch('/settings/change-email', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ new_email: newEmail })
        });
        const data = await res.json();
        closeEmailDialog();
        if (data.success) {
            document.getElementById('currentEmailDisplay').innerText = data.newEmail;
            showAlertDialog("Success!", data.message, true);
            document.getElementById('changeEmailForm').reset();
        } else {
            showAlertDialog("Error", data.message, false);
        }
    } catch(err) {
        showAlertDialog("Error", "Server Error.", false);
    }
    return false; 
}

async function confirmDeleteProfile() {
    try {
        const res = await fetch('/settings/delete-profile');
        const data = await res.json();
        closeDeleteDialogs();
        if(data.success) {
            showAlertDialog("Profile Deleted", data.message, true, '/');
        } else {
            showAlertDialog("Error", data.message, false);
        }
    } catch(err) {
        showAlertDialog("Error", "Server Error.", false);
    }
}
</script>

<script>
// ===== NOTIFICATION SETTINGS =====

function _updateNotifBadge() {
    const badge = document.getElementById('notifStatusBadge');
    if (!badge) return;
    const perm = (typeof Notification !== 'undefined') ? Notification.permission : 'default';
    if (perm === 'granted') {
        badge.innerText = 'ON';
        badge.style.background = '#e6f7f5';
        badge.style.color = '#0f9d9a';
    } else if (perm === 'denied') {
        badge.innerText = 'Blocked';
        badge.style.background = '#fde8e8';
        badge.style.color = '#d9534f';
    } else {
        badge.innerText = 'OFF';
        badge.style.background = '#f1f1f1';
        badge.style.color = '#888';
    }
}

function openNotifDialog() {
    if (typeof Notification === 'undefined' || !('serviceWorker' in navigator)) {
        alert('Push notifications are not supported in this browser.');
        return;
    }

    document.getElementById('notifDialog').style.display = 'flex';
    const perm = Notification.permission;
    const msg  = document.getElementById('notifDialogMsg');
    const btn  = document.getElementById('notifDialogBtn');

    if (perm === 'granted') {
        msg.innerHTML = '✅ Notifications are <strong style="color:#0f9d9a;">enabled</strong>.<br><br>You will receive task alerts even when the browser is closed.';
        btn.innerText = '✅ Already Enabled';
        btn.style.background = '#aaa';
        btn.style.cursor = 'default';
        btn.disabled = true;

    } else if (perm === 'denied') {
        msg.innerHTML = `❌ Notifications are <strong style="color:#d9534f;">blocked</strong> by your browser.<br><br>
            To fix this:<br>
            <span style="font-size:13px;line-height:2.2;display:block;margin-top:4px;">
            1️⃣ Click the <strong>🔒 lock icon</strong> in the address bar<br>
            2️⃣ Find <strong>Notifications</strong> → set to <strong>Allow</strong><br>
            3️⃣ <strong>Reload</strong> this page
            </span>`;
        btn.innerText = '📋 Copy These Steps';
        btn.style.background = '#6c757d';
        btn.style.cursor = 'pointer';
        btn.disabled = false;

    } else {
        msg.innerHTML = 'Notifications are <strong>off</strong>.<br><br>Click below and then click <strong>Allow</strong> in the browser popup to start receiving task alerts.';
        btn.innerText = '🔔 Enable Notifications';
        btn.style.background = '#0f9d9a';
        btn.style.cursor = 'pointer';
        btn.disabled = false;
    }

    _updateNotifBadge();
}

function closeNotifDialog() {
    document.getElementById('notifDialog').style.display = 'none';
}

async function handleNotifAction() {
    const perm = Notification.permission;

    if (perm === 'denied') {
        // Browser blocked — can't show popup. Copy steps to clipboard.
        const steps = 'To enable notifications:\n1. Click the lock icon in the address bar\n2. Find Notifications → set to Allow\n3. Reload the page';
        try {
            await navigator.clipboard.writeText(steps);
            const btn = document.getElementById('notifDialogBtn');
            const orig = btn.innerText;
            btn.innerText = '✅ Copied to Clipboard!';
            setTimeout(() => { btn.innerText = orig; }, 2500);
        } catch(e) {
            alert('To enable: click the 🔒 lock icon in address bar → Notifications → Allow → Reload.');
        }
        return;
    }

    if (perm === 'granted') return;

    // 'default' — ask permission via Beams flow
    try {
        if (typeof requestBeamsPermission === 'function') {
            await requestBeamsPermission();
        } else {
            await Notification.requestPermission();
        }
    } catch(e) {
        console.warn('[Notif] Permission error:', e);
    }

    // Refresh dialog to show new state
    openNotifDialog();
}

// Run on page load to set badge correctly
_updateNotifBadge();
</script>

<script>
// ===== EXPORT TASKS =====
let exportState = { section: '', date: '', tasks: [] };

// ✅ INITIALIZE FLATPICKR FOR EXPORT PROMPT
document.addEventListener('DOMContentLoaded', () => {
  const dateBtn = document.getElementById('exportDateBtn');
  const dateInput = document.getElementById('exportDateInput');
  
  if (dateInput) {
    window._fpExport = flatpickr(dateInput, {
      dateFormat: 'Y-m-d',
      appendTo: document.body,
      disableMobile: true,
      onOpen: function(selectedDates, dateStr, instance) {
        const rect = dateBtn.getBoundingClientRect();
        const cal = instance.calendarContainer;
        cal.style.position = 'fixed';
        cal.style.top = (rect.bottom + 6) + 'px';
        cal.style.left = Math.min(rect.left, window.innerWidth - 290) + 'px';
        cal.style.zIndex = '10000';
        cal.style.transform = 'none';
      },
      onChange: function(selectedDates, dateStr) {
        if (!dateStr) return;
        loadExportPreview(dateStr);
      }
    });

    dateBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      window._fpExport.open();
    });
  }
});

const EXPORT_SECTIONS = [
  { key: 'TASK',      label: 'Task' },
  { key: 'CHANGES',   label: '<%= label_changes %>' },
  { key: 'UPDATE',    label: '<%= label_update %>' },
  { key: 'OTHERS',    label: 'Others' },
  { key: 'COMPLETED', label: 'Completed' },
];

function openExportDialog() {
  exportStep(1);
  const container = document.getElementById('exportSectionBtns');
  container.innerHTML = '';
  EXPORT_SECTIONS.forEach(sec => {
    const btn = document.createElement('button');
    btn.type = 'button'; btn.className = 'export-pick-btn';
    btn.innerHTML = sec.label + ' <span style="float:right;color:#aaa;">›</span>';
    btn.onclick = () => { exportState.section = sec.key; exportStep(2); };
    container.appendChild(btn);
  });
  document.getElementById('exportDialog').style.display = 'flex';
}

function closeExportDialog() { document.getElementById('exportDialog').style.display = 'none'; }

function exportStep(n) {
  document.getElementById('export-step1').style.display = n === 1 ? 'block' : 'none';
  document.getElementById('export-step2').style.display = n === 2 ? 'block' : 'none';
  document.getElementById('export-step3').style.display = n === 3 ? 'block' : 'none';
  if (n === 2) {
    document.getElementById('exportDateInput').value = '';
    document.getElementById('exportDateLabel').innerText = 'Pick a Date';
    exportState.date = '';
    if (window._fpExport) window._fpExport.clear(); // Reset custom calendar value cleanly
  }
}

async function loadExportPreview(date) {
  exportState.date = date;
  if (date) document.getElementById('exportDateLabel').innerText = 'Selected: ' + date;
  exportStep(3);
  document.getElementById('exportLoading').style.display = 'block';
  document.getElementById('exportPreviewList').innerHTML = '';
  document.getElementById('exportExcelBtn').disabled = true;
  document.getElementById('exportCsvBtn').disabled = true;

  try {
    let url = `/task-export?section=${exportState.section}`;
    if (date) url += `&date=${date}`;
    const res = await fetch(url);
    const data = await res.json();
    exportState.tasks = data.tasks || [];
  } catch { exportState.tasks = []; }

  document.getElementById('exportLoading').style.display = 'none';
  document.getElementById('exportCount').innerText = exportState.tasks.length + ' tasks found';

  const list = document.getElementById('exportPreviewList');
  const pColors = { HIGH: '#ef4444', MEDIUM: '#eab308', LOW: '#3b82f6' };

  if (exportState.tasks.length === 0) {
    list.innerHTML = '<div style="text-align:center;color:#888;padding:20px;">No tasks found</div>';
  } else {
    exportState.tasks.forEach(t => {
      const p = (t.priority || 'LOW').toUpperCase();
      const div = document.createElement('div'); div.className = 'exp-card';
      div.style.borderLeftColor = pColors[p] || '#ccc';
      div.innerHTML = `
        <div style="font-weight:600;color:#1a1a1a;font-size:13px;margin-bottom:3px;">${t.title || ''}</div>
        <div style="font-size:11px;color:#888;display:flex;gap:10px;">
          <span>📅 ${t.due_date || 'No date'}</span>
          <span style="color:${pColors[p]};font-weight:700;">${p}</span>
          ${t.assigned_by_name ? `<span>👤 ${t.assigned_by_name}</span>` : ''}
        </div>`;
      list.appendChild(div);
    });
  }
  document.getElementById('exportExcelBtn').disabled = exportState.tasks.length === 0;
  document.getElementById('exportCsvBtn').disabled = exportState.tasks.length === 0;
}

async function doExportExcel() {
  const filename = `tasks-${exportState.section}-${exportState.date || 'all'}`;
  if (!window.ExcelJS) {
    await new Promise((res, rej) => {
      const s = document.createElement('script');
      s.src = 'https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js';
      s.onload = res; s.onerror = rej; document.head.appendChild(s);
    });
  }
  const wb = new ExcelJS.Workbook();
  const ws = wb.addWorksheet('Tasks');
  ws.columns = [
    { key: 'title', width: 32 }, { key: 'desc', width: 42 },
    { key: 'priority', width: 12 }, { key: 'due', width: 16 },
    { key: 'created', width: 16 }, { key: 'by', width: 24 }, { key: 'status', width: 12 },
  ];
  const hr = ws.addRow(['Title', 'Description', 'Priority', 'Due Date', 'Created At', 'Assigned By', 'Status']);
  hr.height = 22;
  hr.eachCell(cell => {
    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF0F8989' } };
    cell.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 };
    cell.alignment = { horizontal: 'center', vertical: 'middle' };
  });
  const pc = { HIGH: { bg: 'FFCCCC', font: 'C0392B' }, MEDIUM: { bg: 'FFF9C4', font: 'B8860B' }, LOW: { bg: 'CCE5FF', font: '1A5276' } };
  exportState.tasks.forEach(t => {
    const p = (t.priority || 'LOW').toUpperCase();
    const c = pc[p] || pc.LOW;
    const row = ws.addRow([t.title||'', t.description||'', p, t.due_date||'', t.created_at||'', t.assigned_by_name||(t.is_self?'Self':''), t.status||'']);
    row.height = 20;
    row.eachCell({ includeEmpty: true }, (cell, col) => {
      cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF' + c.bg } };
      cell.font = { size: 11, color: { argb: col === 3 ? 'FF' + c.font : 'FF1A1A1A' }, bold: col === 3 };
      cell.alignment = { vertical: 'middle', horizontal: col === 3 ? 'center' : 'left', wrapText: col === 2 };
    });
  });
  const buffer = await wb.xlsx.writeBuffer();
  const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = filename + '.xlsx';
  document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
}

function doExportCsv() {
  const header = ['Title', 'Description', 'Priority', 'Due Date', 'Created At', 'Assigned By', 'Status'];
  const rows = exportState.tasks.map(t => [
    `"${(t.title||'').replace(/"/g,'""')}"`,
    `"${(t.description||'').replace(/"/g,'""')}"`,
    t.priority||'', t.due_date||'', t.created_at||'',
    `"${((t.assigned_by_name||(t.is_self?'Self':''))||'').replace(/"/g,'""')}"`,
    t.status||''
  ]);
  const csv = [header.join(','), ...rows.map(r => r.join(','))].join('\n');
  const blob = new Blob([csv], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = `tasks-${exportState.section}-${exportState.date||'all'}.csv`;
  document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
}
</script>
</body>
</html>
